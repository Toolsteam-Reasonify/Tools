{
    "tool_name": "tiling_explorer",
    "version": "1.3.0",
    "description": "Interactive educational tool for exploring geometric tiling and tessellation concepts with three learning modes",
    "category": "mathematics",
    "subcategory": "geometry",
    "grade_level": "6-8",
    "curriculum_alignment": {
        "framework": "NCERT Ganita Prakash",
        "grade": 7,
        "chapter": "6.2 Tiling",
        "pages": "155-162"
    },
    "modes": {
        "learn": {
            "name": "Interactive Learning",
            "description": "Hands-on exploration with interactive grid canvas",
            "features": [
                "Click-to-place tiles",
                "Adjustable grid dimensions",
                "Color selection",
                "Tileability checker",
                "Auto-solve functionality",
                "Checkerboard visualization"
            ]
        },
        "practice": {
            "name": "Practice Questions",
            "description": "Multiple-choice questions with immediate feedback",
            "features": [
                "5 default questions",
                "Custom questions support",
                "Immediate feedback",
                "Detailed explanations",
                "Progress tracking"
            ]
        },
        "realworld": {
            "name": "Real World Applications",
            "description": "Examples of tiling in nature, art, and technology",
            "features": [
                "5 default examples",
                "Custom examples support",
                "Mathematical connections",
                "Fun facts",
                "Visual presentations"
            ]
        }
    },
    "props_schema": {
        "type": "object",
        "properties": {
            "props": {
                "type": "object",
                "properties": {
                    "width": {
                        "type": "number",
                        "default": 800,
                        "description": "Component width in pixels"
                    },
                    "height": {
                        "type": "number",
                        "default": 600,
                        "description": "Component height in pixels"
                    },
                    "initialMode": {
                        "type": "string",
                        "enum": [
                            "learn",
                            "practice",
                            "realworld"
                        ],
                        "default": "learn",
                        "description": "Starting mode when tool loads"
                    },
                    "showModeSelector": {
                        "type": "boolean",
                        "default": true,
                        "description": "Show/hide mode navigation tabs"
                    },
                    "enabledModes": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "learn",
                                "practice",
                                "realworld"
                            ]
                        },
                        "default": [
                            "learn",
                            "practice",
                            "realworld"
                        ],
                        "description": "Which modes are available to students"
                    },
                    "showNavigation": {
                        "type": "boolean",
                        "default": true,
                        "description": "Show/hide previous/next buttons"
                    },
                    "showStepIndicator": {
                        "type": "boolean",
                        "default": true,
                        "description": "Show/hide progress indicators and question counters"
                    },
                    "initialStep": {
                        "type": "number",
                        "default": 0,
                        "description": "Starting step/question index"
                    },
                    "filterSteps": {
                        "type": "array",
                        "items": {
                            "type": "number"
                        },
                        "description": "Only show these specific step IDs (for targeted practice)"
                    },
                    "animationSpeed": {
                        "type": "number",
                        "default": 1,
                        "minimum": 0.1,
                        "maximum": 3,
                        "description": "Animation speed multiplier (1 = normal, 2 = 2x faster)"
                    },
                    "themeColor": {
                        "type": "string",
                        "default": "#4A4DC9",
                        "description": "Primary theme color (hex code)"
                    },
                    "darkMode": {
                        "type": "boolean",
                        "default": false,
                        "description": "Enable dark mode theme"
                    },
                    "additionalProps": {
                        "type": "object",
                        "description": "Tool-specific configuration options",
                        "properties": {
                            "gridRows": {
                                "type": "number",
                                "default": 5,
                                "minimum": 2,
                                "maximum": 15,
                                "description": "Number of rows in the tiling grid"
                            },
                            "gridCols": {
                                "type": "number",
                                "default": 6,
                                "minimum": 2,
                                "maximum": 15,
                                "description": "Number of columns in the tiling grid"
                            },
                            "gridType": {
                                "type": "string",
                                "enum": [
                                    "rectangular",
                                    "hexagonal",
                                    "triangular"
                                ],
                                "default": "rectangular",
                                "description": "Type of grid pattern"
                            },
                            "tileType": {
                                "type": "string",
                                "enum": [
                                    "2x1",
                                    "square",
                                    "equilateral",
                                    "hexagon"
                                ],
                                "default": "2x1",
                                "description": "Type of tile shape to use"
                            },
                            "tileColors": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": [
                                    "#FF7212",
                                    "#FC9145",
                                    "#4A4DC9",
                                    "#C1C1EA",
                                    "#4ECDC4",
                                    "#C44569",
                                    "#8B4789",
                                    "#2ECC71"
                                ],
                                "description": "Available tile colors (hex codes)"
                            },
                            "selectedColor": {
                                "type": "string",
                                "default": "#FF7212",
                                "description": "Initially selected tile color"
                            },
                            "showCheckerboard": {
                                "type": "boolean",
                                "default": false,
                                "description": "Display checkerboard pattern on grid"
                            },
                            "autoSolve": {
                                "type": "boolean",
                                "default": false,
                                "description": "Automatically solve the grid on load"
                            },
                            "customQuestions": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/MCQQuestion"
                                },
                                "description": "Custom practice questions (replaces defaults)"
                            },
                            "customExamples": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/RealWorldExample"
                                },
                                "description": "Custom real-world examples (replaces defaults)"
                            }
                        }
                    }
                }
            },
            "setStepDetails": {
                "type": "function",
                "description": "Callback to notify parent of current step/mode changes"
            },
            "stopAutoNext": {
                "type": "boolean",
                "default": false,
                "description": "Stop automatic progression"
            },
            "setStopAutoNext": {
                "type": "function",
                "description": "Callback to control auto-progression"
            }
        }
    },
    "definitions": {
        "MCQQuestion": {
            "type": "object",
            "required": [
                "id",
                "question",
                "options",
                "correctAnswer",
                "explanation"
            ],
            "properties": {
                "id": {
                    "type": "number",
                    "description": "Unique question identifier"
                },
                "question": {
                    "type": "string",
                    "description": "Question text"
                },
                "options": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "Four answer options"
                },
                "correctAnswer": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3,
                    "description": "Index of correct answer (0-3)"
                },
                "explanation": {
                    "type": "string",
                    "description": "Explanation shown after answering"
                }
            }
        },
        "RealWorldExample": {
            "type": "object",
            "required": [
                "id",
                "title",
                "description",
                "image",
                "connection",
                "funFact"
            ],
            "properties": {
                "id": {
                    "type": "number",
                    "description": "Unique example identifier"
                },
                "title": {
                    "type": "string",
                    "description": "Example title with emoji"
                },
                "description": {
                    "type": "string",
                    "description": "Detailed description of the example"
                },
                "image": {
                    "type": "string",
                    "description": "Emoji or short text representing the example"
                },
                "connection": {
                    "type": "string",
                    "description": "Mathematical connection to tiling concepts"
                },
                "funFact": {
                    "type": "string",
                    "description": "Interesting fact related to the example"
                }
            }
        },
        "StepDetails": {
            "type": "object",
            "properties": {
                "currentStep": {
                    "type": "number",
                    "description": "Current step number (1-indexed)"
                },
                "totalSteps": {
                    "type": "number",
                    "description": "Total number of steps in current mode"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "learn",
                        "practice",
                        "realworld"
                    ],
                    "description": "Current active mode"
                }
            }
        }
    },
    "default_questions": [
        {
            "id": 1,
            "question": "A rectangular grid has 5 rows and 7 columns. Can it be perfectly tiled with 2×1 domino tiles?",
            "topic": "Parity and tileability",
            "difficulty": "medium"
        },
        {
            "id": 2,
            "question": "In the checkerboard coloring technique, each 2×1 domino tile covers:",
            "topic": "Checkerboard proof technique",
            "difficulty": "easy"
        },
        {
            "id": 3,
            "question": "Which of these regular polygons CANNOT tile a plane by itself?",
            "topic": "Regular polygon tessellation",
            "difficulty": "medium"
        },
        {
            "id": 4,
            "question": "Why do bees use hexagonal cells in their hives?",
            "topic": "Real-world applications",
            "difficulty": "easy"
        },
        {
            "id": 5,
            "question": "A 6×8 grid has two opposite corner squares removed. Can it be tiled with 2×1 dominoes?",
            "topic": "Advanced checkerboard reasoning",
            "difficulty": "hard"
        }
    ],
    "default_examples": [
        {
            "id": 1,
            "title": "Honeycomb: Nature's Perfect Tessellation",
            "domain": "nature",
            "topic": "Hexagonal tiling efficiency"
        },
        {
            "id": 2,
            "title": "Islamic Geometric Art",
            "domain": "art",
            "topic": "Complex tessellation patterns"
        },
        {
            "id": 3,
            "title": "Video Game Graphics",
            "domain": "technology",
            "topic": "Texture tiling"
        },
        {
            "id": 4,
            "title": "Digital Maps",
            "domain": "technology",
            "topic": "Square tile systems"
        },
        {
            "id": 5,
            "title": "Turtle Shells",
            "domain": "nature",
            "topic": "Natural tessellation patterns"
        }
    ],
    "usage_examples": [
        {
            "name": "Basic exploration",
            "description": "Default settings for open-ended exploration",
            "parameters": {}
        },
        {
            "name": "Custom grid size",
            "description": "Larger grid for advanced students",
            "parameters": {
                "additionalProps": {
                    "gridRows": 8,
                    "gridCols": 10
                }
            }
        },
        {
            "name": "Checkerboard demonstration",
            "description": "Start with checkerboard visible for proof technique",
            "parameters": {
                "additionalProps": {
                    "gridRows": 6,
                    "gridCols": 6,
                    "showCheckerboard": true
                }
            }
        },
        {
            "name": "Practice mode only",
            "description": "Assessment-focused configuration",
            "parameters": {
                "initialMode": "practice",
                "showModeSelector": false,
                "enabledModes": [
                    "practice"
                ]
            }
        },
        {
            "name": "Real world only",
            "description": "Motivation and context building",
            "parameters": {
                "initialMode": "realworld",
                "showModeSelector": false,
                "enabledModes": [
                    "realworld"
                ]
            }
        },
        {
            "name": "Minimal UI demo",
            "description": "Focused demonstration without navigation",
            "parameters": {
                "showModeSelector": false,
                "showNavigation": false,
                "showStepIndicator": false,
                "additionalProps": {
                    "gridRows": 4,
                    "gridCols": 6
                }
            }
        },
        {
            "name": "Auto-solve demonstration",
            "description": "Show automatic tiling solution",
            "parameters": {
                "additionalProps": {
                    "gridRows": 5,
                    "gridCols": 6,
                    "autoSolve": true
                }
            }
        },
        {
            "name": "Odd grid challenge",
            "description": "Let students discover impossibility",
            "parameters": {
                "additionalProps": {
                    "gridRows": 5,
                    "gridCols": 7
                }
            }
        },
        {
            "name": "Custom colors",
            "description": "Personalized color palette",
            "parameters": {
                "additionalProps": {
                    "tileColors": [
                        "#FF0000",
                        "#00FF00",
                        "#0000FF",
                        "#FFFF00",
                        "#FF00FF",
                        "#00FFFF"
                    ],
                    "selectedColor": "#FF0000"
                }
            }
        },
        {
            "name": "Fast animations",
            "description": "Increased animation speed for demos",
            "parameters": {
                "animationSpeed": 2,
                "additionalProps": {
                    "autoSolve": true
                }
            }
        }
    ],
    "educational_concepts": {
        "primary": [
            "Tiling/tessellation definition",
