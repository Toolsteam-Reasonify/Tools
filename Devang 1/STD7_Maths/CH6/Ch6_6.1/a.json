{
    "tool_name": "geometric_construction_tool",
    "version": "1.0.0",
    "description": "Interactive tool for teaching geometric constructions using compass and straightedge, covering perpendicular bisectors, angle bisectors, and regular polygons",
    "category": "mathematics",
    "subcategory": "geometry",
    "grade_levels": [
        6,
        7,
        8,
        9
    ],
    "learning_objectives": [
        "Construct perpendicular bisectors using compass and straightedge",
        "Construct angle bisectors for any given angle",
        "Construct 60°, 90°, and other special angles",
        "Copy angles accurately",
        "Construct parallel lines",
        "Construct regular hexagons",
        "Understand congruence principles in constructions",
        "Test knowledge through self-assessment questions",
        "Connect geometric concepts to real-world applications"
    ],
    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Canvas width in pixels"
        },
        "height": {
            "type": "number",
            "default": 600,
            "description": "Canvas height in pixels"
        },
        "data": {
            "type": "object",
            "description": "Base data interface with fallback values",
            "properties": {
                "themeColor": {
                    "type": "string",
                    "description": "Fallback theme color"
                },
                "autoPlayDuration": {
                    "type": "number",
                    "description": "Fallback auto-play duration in milliseconds"
                }
            },
            "additionalProperties": true
        },
        "steps": {
            "type": "array",
            "description": "Custom step data (StepDataInterface[])",
            "items": {
                "type": "object"
            }
        },
        "initialMode": {
            "type": "string",
            "enum": [
                "learn",
                "practice",
                "explore"
            ],
            "default": "learn",
            "description": "Starting mode for the tool (must be in enabledModes)"
        },
        "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Show or hide mode selection tabs"
        },
        "enabledModes": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": ["learn", "practice", "explore"]
            },
            "default": ["learn", "practice", "explore"],
            "description": "Which modes to enable in the mode selector"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show or hide previous/next navigation buttons"
        },
        "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show or hide play/pause button"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show or hide step counter"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier (0.5 = slower, 2 = faster)"
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 8000,
            "description": "Time in milliseconds before auto-advancing to next step (or from data.autoPlayDuration)"
        },
        "themeColor": {
            "type": "string",
            "default": "#3b82f6",
            "description": "Primary theme color (hex format, or from data.themeColor)"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode theme"
        },
        "additionalProps": {
            "type": "object",
            "description": "Dynamic content for customizing constructions",
            "properties": {
                "constructionType": {
                    "type": "string",
                    "enum": [
                        "perpendicular_bisector",
                        "angle_bisector",
                        "90_degree_angle",
                        "60_degree_angle",
                        "copy_angle",
                        "parallel_lines",
                        "regular_hexagon"
                    ],
                    "default": "perpendicular_bisector",
                    "description": "Type of geometric construction to demonstrate"
                },
                "showGrid": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show background grid for reference"
                },
                "showLabels": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show point labels (A, B, X, Y, etc.)"
                },
                "lineSegmentLength": {
                    "type": "number",
                    "default": 200,
                    "description": "Length of initial line segment in pixels"
                },
                "angleToConstruct": {
                    "type": "number",
                    "default": 60,
                    "description": "Angle measure for angle construction/bisection (in degrees)"
                },
                "customPoints": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            },
                            "label": {
                                "type": "string"
                            }
                        }
                    },
                    "description": "Custom starting points for construction"
                },
                "guidedMode": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show step-by-step guidance"
                },
                "showConstructionSteps": {
                    "type": "boolean",
                    "default": true,
                    "description": "Display construction instructions panel"
                }
            }
        }
    },
    "modes": {
        "learn": {
            "description": "Step-by-step guided construction with explanations",
            "features": [
                "Detailed instructions for each step",
                "Visual animations showing construction process",
                "Theoretical explanations",
                "Congruence proofs",
                "Only NEW elements animate in each step"
            ]
        },
        "practice": {
            "description": "Test your knowledge with MCQ questions",
            "features": [
                "5 multiple choice questions",
                "4 options per question",
                "One question at a time",
                "Self-assessment (no correct answers shown)",
                "Previous/Next navigation",
                "Topics: definitions, properties, construction principles"
            ]
        },
        "explore": {
            "description": "Discover real-world applications of geometric constructions",
            "display_name": "Real World",
            "features": [
                "5 real-world application examples",
                "One example at a time",
                "Career and life connections",
                "Practical use cases",
                "Previous/Next navigation",
                "Examples: GPS, architecture, sports, urban planning"
            ]
        }
    },
    "examples": {
        "example_1_basic_perpendicular_bisector": {
            "title": "Perpendicular Bisector - Full Tutorial",
            "use_case": "Student wants to learn how to construct a perpendicular bisector",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Constructing a Perpendicular Bisector",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "showModeSelector": true,
                        "additionalProps": {
                            "constructionType": "perpendicular_bisector",
                            "showGrid": true,
                            "showLabels": true,
                            "guidedMode": true
                        }
                    }
                },
                "instructions_for_student": "Follow the steps to construct a perpendicular bisector using only a compass and straightedge!"
            }
        },
        "example_2_angle_bisector": {
            "title": "Angle Bisector Construction",
            "use_case": "Student asks 'How do I bisect an angle?'",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Bisecting Any Angle",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "additionalProps": {
                            "constructionType": "angle_bisector",
                            "angleToConstruct": 80,
                            "showConstructionSteps": true,
                            "guidedMode": true
                        }
                    }
                },
                "instructions_for_student": "Learn to divide any angle into two equal parts!"
            }
        },
        "example_3_construct_60_degree": {
            "title": "Constructing a 60° Angle",
            "use_case": "Student wants to construct a 60 degree angle",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "60° Angle Construction",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "additionalProps": {
                            "constructionType": "60_degree_angle",
                            "angleToConstruct": 60,
                            "showGrid": false
                        }
                    }
                },
                "instructions_for_student": "Construct a 60° angle by creating an equilateral triangle!"
            }
        },
        "example_4_practice_mode": {
            "title": "Practice Mode - MCQ Questions",
            "use_case": "Student wants to test their understanding",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Test Your Knowledge",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "practice",
                        "showModeSelector": true,
                        "additionalProps": {
                            "guidedMode": false
                        }
                    }
                },
                "instructions_for_student": "Answer 5 multiple choice questions to test your understanding of geometric constructions!"
            }
        },
        "example_5_real_world_applications": {
            "title": "Real World Applications",
            "use_case": "Student asks 'Where is this used in real life?'",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Real World Applications",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "explore",
                        "showModeSelector": false,
                        "themeColor": "#10b981"
                    }
                },
                "instructions_for_student": "See how perpendicular bisectors are used in GPS, architecture, sports, and more!"
            }
        },
        "example_5_regular_hexagon": {
            "title": "Constructing a Regular Hexagon",
            "use_case": "Student asks about constructing regular polygons",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Regular Hexagon Construction",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "autoPlayDuration": 10000,
                        "additionalProps": {
                            "constructionType": "regular_hexagon",
                            "showLabels": true,
                            "showGrid": false
                        }
                    }
                },
                "instructions_for_student": "A regular hexagon can be made from 6 equilateral triangles!"
            }
        },
        "example_6_parallel_lines": {
            "title": "Constructing Parallel Lines",
            "use_case": "Student wants to construct parallel lines without a protractor",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Parallel Lines Construction",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "themeColor": "#10b981",
                        "additionalProps": {
                            "constructionType": "parallel_lines",
                            "showConstructionSteps": true
                        }
                    }
                },
                "instructions_for_student": "Construct parallel lines by copying corresponding angles!"
            }
        },
        "example_7_90_degree_angle": {
            "title": "Constructing a Right Angle",
            "use_case": "Student needs to construct a 90 degree angle at a point",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "90° Angle Construction",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "additionalProps": {
                            "constructionType": "90_degree_angle",
                            "angleToConstruct": 90,
                            "showGrid": true
                        }
                    }
                },
                "instructions_for_student": "Construct a perpendicular line at any point!"
            }
        },
        "example_8_copy_angle": {
            "title": "Copying an Angle",
            "use_case": "Student wants to copy an angle to a different location",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Copy an Angle",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "initialMode": "learn",
                        "additionalProps": {
                            "constructionType": "copy_angle",
                            "angleToConstruct": 45,
                            "showLabels": true
                        }
                    }
                },
                "instructions_for_student": "Learn to create an exact copy of any angle!"
            }
        },
        "example_9_minimal_ui": {
            "title": "Clean Display - Just the Construction",
            "use_case": "Agent wants to show construction without UI distractions",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Perpendicular Bisector",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "showModeSelector": false,
                        "showNavigation": false,
                        "showPlayPause": false,
                        "showStepIndicator": false,
                        "autoPlayDuration": 0,
                        "additionalProps": {
                            "constructionType": "perpendicular_bisector",
                            "showGrid": false,
                            "showConstructionSteps": false
                        }
                    }
                },
                "instructions_for_student": "Here's how the perpendicular bisector divides the line!"
            }
        },
        "example_10_dark_mode": {
            "title": "Dark Mode Geometry",
            "use_case": "Student prefers dark theme",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Geometric Constructions",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "darkMode": true,
                        "themeColor": "#60a5fa",
                        "additionalProps": {
                            "constructionType": "angle_bisector",
                            "angleToConstruct": 120
                        }
                    }
                },
                "instructions_for_student": "Angle bisection in dark mode!"
            }
        },
        "example_11_data_and_enabled_modes": {
            "title": "Using Data Interface and Enabled Modes",
            "use_case": "Custom configuration with data fallbacks and restricted modes",
            "tool_call": {
                "frontend_action": "show_interactive_tool",
                "title": "Learn Mode Only - Perpendicular Bisector",
                "data": {
                    "toolName": "geometric_construction_tool",
                    "parameters": {
                        "data": {
                            "themeColor": "#10b981",
                            "autoPlayDuration": 10000
                        },
                        "enabledModes": ["learn"],
                        "initialMode": "learn",
                        "additionalProps": {
                            "constructionType": "perpendicular_bisector",
                            "showGrid": true
                        }
                    }
                },
                "instructions_for_student": "Learn mode only - focus on understanding the construction!"
            }
        }
    },
    "pedagogical_notes": {
        "key_concepts": [
            "Perpendicular bisector construction and properties",
            "Angle bisection using congruent triangles",
            "Special angle construction (60°, 90°, 45°, 30°, 15°)",
            "Parallel lines construction using corresponding angles",
            "Regular polygon construction",
            "Congruence conditions (SSS, SAS)",
            "Compass and straightedge as fundamental tools"
        ],
        "common_misconceptions": [
            "Students may think measurement is needed (emphasize construction-only approach)",
            "Confusion about why equal radii are important in bisector construction",
            "Not understanding the role of congruent triangles in proofs",
            "Thinking all regular polygons can be constructed (only some can)"
        ],
        "teaching_tips": [
            "Start with perpendicular bisector as foundational skill",
            "Connect constructions to congruence theorems",
            "Reference historical Śulba-Sūtras for cultural context",
            "Practice with real compass and straightedge after digital learning",
            "Show how 60° construction leads to regular hexagon",
            "Emphasize that constructions are exact, not approximate"
        ]
    },
    "related_tools": [
        "triangle_construction_tool",
        "angle_measurement_tool",
        "polygon_explorer",
        "congruence_proof_tool"
    ],
    "technical_details": {
        "rendering": "HTML5 Canvas with animated drawing",
        "animations": "CSS keyframes + requestAnimationFrame",
        "performance": "Optimized for 60fps animation",
        "accessibility": "Step instructions provided in text"
    }
}