{
    "toolName": "water_cycle",
    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Overall component width in pixels",
            "min": 400,
            "max": 2000
        },
        "height": {
            "type": "number",
            "default": 600,
            "description": "Overall component height in pixels",
            "min": 300,
            "max": 1500
        },
        "initialMode": {
            "type": "string",
            "enum": [
                "learn",
                "practice",
                "realWorld"
            ],
            "default": "learn",
            "description": "Starting mode when tool loads"
        },
        "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide the mode selection tabs at the top"
        },
        "enabledModes": {
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "learn",
                    "practice",
                    "realWorld"
                ]
            },
            "default": [
                "learn",
                "practice",
                "realWorld"
            ],
            "description": "Which modes are available to the user"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide previous and next navigation buttons"
        },
        "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide play/pause button for auto-advance"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide step counter dots (e.g., '• • • •')"
        },
        "initialStep": {
            "type": "number",
            "default": 0,
            "description": "Starting step index (0-based) for learn mode",
            "min": 0,
            "max": 3
        },
        "filterSteps": {
            "type": "array",
            "items": {
                "type": "number",
                "min": 1,
                "max": 4
            },
            "default": null,
            "description": "Array of step IDs to display (1=evaporation, 2=condensation, 3=precipitation, 4=collection)"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier (1 = normal, 2 = double speed)",
            "min": 0.5,
            "max": 3
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 7000,
            "description": "Milliseconds to wait before auto-advancing to next phase (0 = disabled)",
            "min": 0,
            "max": 60000
        },
        "themeColor": {
            "type": "string",
            "default": "#2196f3",
            "description": "Primary theme color in hex format",
            "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode theme"
        },
        "additionalProps": {
            "type": "object",
            "description": "Dynamic custom content and visual settings",
            "properties": {
                "customPhases": {
                    "type": "object",
                    "description": "Replace default phase information",
                    "patternProperties": {
                        "^(evaporation|condensation|precipitation|collection)$": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string"
                                },
                                "simple": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 3,
                                    "maxItems": 3
                                },
                                "example": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "minItems": 3,
                                    "maxItems": 4
                                }
                            },
                            "required": [
                                "title",
                                "simple",
                                "example"
                            ]
                        }
                    }
                },
                "customQuestions": {
                    "type": "array",
                    "description": "Replace default practice questions",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number"
                            },
                            "question": {
                                "type": "string"
                            },
                            "options": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 2,
                                "maxItems": 6
                            },
                            "correctAnswer": {
                                "type": "number",
                                "description": "Index of correct answer (0-based)"
                            },
                            "explanation": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "question",
                            "options",
                            "correctAnswer",
                            "explanation"
                        ]
                    }
                },
                "customExamples": {
                    "type": "array",
                    "description": "Replace default real-world applications",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "number"
                            },
                            "title": {
                                "type": "string"
                            },
                            "location": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "category": {
                                "type": "string"
                            },
                            "impact": {
                                "type": "string"
                            },
                            "keyFeatures": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "connection": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "id",
                            "title",
                            "location",
                            "description",
                            "category",
                            "impact",
                            "keyFeatures",
                            "connection"
                        ]
                    }
                },
                "animationDuration": {
                    "type": "number",
                    "description": "Overall animation timing adjustment (experimental)",
                    "default": 7000
                },
                "waveSpeed": {
                    "type": "number",
                    "description": "Ocean wave animation speed multiplier (experimental)",
                    "default": 1
                },
                "rainSpeed": {
                    "type": "number",
                    "description": "Rain drop fall speed multiplier (experimental)",
                    "default": 1
                },
                "skyColor": {
                    "type": "string",
                    "description": "Custom sky gradient color",
                    "default": "#87ceeb"
                },
                "oceanColor": {
                    "type": "string",
                    "description": "Custom ocean color",
                    "default": "#2196f3"
                },
                "cloudColor": {
                    "type": "string",
                    "description": "Custom cloud color",
                    "default": "#ffffff"
                },
                "sunColor": {
                    "type": "string",
                    "description": "Custom sun color",
                    "default": "#ffeb3b"
                }
            }
        }
    },
    "usage_example": {}
}