{
  "toolName": "a_torchlight",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Torchlight Circuit Tool Schema",
    "description": "Interactive educational tool for learning about electric circuits using a torchlight example",
    "type": "object",
    "properties": {
      "frontend_action": {
        "type": "string",
        "const": "show_interactive_tool",
        "description": "Action identifier for frontend routing"
      },
      "title": {
        "type": "string",
        "description": "Display title for the tool",
        "default": "Torchlight Circuit Explorer"
      },
      "data": {
        "type": "object",
        "required": [
          "toolName"
        ],
        "properties": {
          "toolName": {
            "type": "string",
            "const": "torchlight_circuit_tool",
            "description": "Unique identifier for this tool"
          },
          "parameters": {
            "type": "object",
            "description": "Configuration parameters for the tool",
            "properties": {
              "width": {
                "type": "number",
                "description": "Canvas width in pixels",
                "default": 800,
                "minimum": 400,
                "maximum": 2000
              },
              "height": {
                "type": "number",
                "description": "Canvas height in pixels",
                "default": 600,
                "minimum": 300,
                "maximum": 1500
              },
              "data": {
                "type": "object",
                "description": "Base configuration data",
                "properties": {
                  "themeColor": {
                    "type": "string",
                    "description": "Primary theme color (hex)",
                    "default": "#3b82f6",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "autoPlayDuration": {
                    "type": "number",
                    "description": "Auto-advance duration in milliseconds (0 = disabled)",
                    "default": 0,
                    "minimum": 0
                  }
                }
              },
              "initialMode": {
                "type": "string",
                "description": "Starting mode for the tool",
                "enum": [
                  "learn",
                  "practice",
                  "real_world",
                  "hands_on"
                ],
                "default": "learn"
              },
              "showModeSelector": {
                "type": "boolean",
                "description": "Show/hide mode selection tabs",
                "default": true
              },
              "enabledModes": {
                "type": "array",
                "description": "Which modes are available to the user",
                "items": {
                  "type": "string",
                  "enum": [
                    "learn",
                    "practice",
                    "real_world",
                    "hands_on"
                  ]
                },
                "default": [
                  "learn",
                  "practice",
                  "real_world",
                  "hands_on"
                ]
              },
              "showNavigation": {
                "type": "boolean",
                "description": "Show/hide previous/next navigation buttons",
                "default": true
              },
              "showPlayPause": {
                "type": "boolean",
                "description": "Show/hide play/pause control button",
                "default": false
              },
              "showStepIndicator": {
                "type": "boolean",
                "description": "Show/hide step counter display",
                "default": true
              },
              "initialStep": {
                "type": "number",
                "description": "Starting step ID (0-indexed)",
                "default": 0,
                "minimum": 0
              },
              "filterSteps": {
                "type": "array",
                "description": "Only show these step IDs (empty = show all)",
                "items": {
                  "type": "number"
                },
                "default": []
              },
              "animationSpeed": {
                "type": "number",
                "description": "Animation speed multiplier",
                "default": 1,
                "minimum": 0.1,
                "maximum": 3
              },
              "autoPlayDuration": {
                "type": "number",
                "description": "Auto-advance delay in milliseconds (0 = disabled)",
                "default": 0,
                "minimum": 0
              },
              "themeColor": {
                "type": "string",
                "description": "Primary theme color (hex)",
                "default": "#3b82f6",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "darkMode": {
                "type": "boolean",
                "description": "Enable dark mode theme",
                "default": false
              },
              "additionalProps": {
                "type": "object",
                "description": "Tool-specific dynamic content and configuration",
                "properties": {
                  "torchState": {
                    "type": "string",
                    "description": "Initial state of the torch",
                    "enum": [
                      "on",
                      "off"
                    ],
                    "default": "off"
                  },
                  "interactive": {
                    "type": "boolean",
                    "description": "Allow user to interact with torch (click to toggle)",
                    "default": true
                  },
                  "highlightComponents": {
                    "type": "array",
                    "description": "Component IDs to highlight in the parts view",
                    "items": {
                      "type": "string",
                      "enum": [
                        "lamp",
                        "switch",
                        "cells",
                        "wires"
                      ]
                    },
                    "default": []
                  },
                  "showCircuit": {
                    "type": "boolean",
                    "description": "Show/hide circuit diagram",
                    "default": false
                  },
                  "circuitComponents": {
                    "type": "array",
                    "description": "Custom circuit components to display",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "type",
                        "position",
                        "connections"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique component identifier"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "cell",
                            "battery",
                            "lamp",
                            "led",
                            "switch",
                            "wire"
                          ],
                          "description": "Component type"
                        },
                        "position": {
                          "type": "object",
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number",
                              "description": "X coordinate in SVG"
                            },
                            "y": {
                              "type": "number",
                              "description": "Y coordinate in SVG"
                            }
                          }
                        },
                        "connections": {
                          "type": "array",
                          "description": "IDs of connected components",
                          "items": {
                            "type": "string"
                          }
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "on",
                            "off",
                            "open",
                            "closed"
                          ],
                          "description": "Component state"
                        }
                      }
                    },
                    "default": []
                  },
                  "customColors": {
                    "type": "object",
                    "description": "Custom color overrides for torch components",
                    "properties": {
                      "torchHead": {
                        "type": "string",
                        "description": "Torch head color when ON (hex)",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "torchBody": {
                        "type": "string",
                        "description": "Torch body color (hex)",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "switchColor": {
                        "type": "string",
                        "description": "Switch color when ON (hex)",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "wireColor": {
                        "type": "string",
                        "description": "Wire color when current flows (hex)",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      }
                    }
                  },
                  "animationSpeed": {
                    "type": "number",
                    "description": "Animation speed multiplier for torch effects",
                    "default": 1,
                    "minimum": 0.1,
                    "maximum": 3
                  },
                  "glowIntensity": {
                    "type": "number",
                    "description": "Glow intensity when torch is ON (0-1). Controls the 5-layer light system: ambient halo, light cone beam, core beam, hot white center, and radiating rays. Higher values increase blur radii and opacity of all light layers.",
                    "default": 0.8,
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lightLayers": {
                    "type": "object",
                    "description": "Fine-grained control over individual torch light layers. Each layer can be independently toggled.",
                    "properties": {
                      "ambientHalo": {
                        "type": "boolean",
                        "description": "Wide soft ambient glow surrounding the beam (Layer 1 — large ellipse with triple-blur filter)",
                        "default": true
                      },
                      "lightCone": {
                        "type": "boolean",
                        "description": "Visible triangular beam cone projecting from the lens (Layer 2 — polygon with gradient fill)",
                        "default": true
                      },
                      "coreBeam": {
                        "type": "boolean",
                        "description": "Concentrated inner bright beam (Layer 3 — radial gradient ellipse with orange-to-white)",
                        "default": true
                      },
                      "hotCenter": {
                        "type": "boolean",
                        "description": "Small white-hot center near the lens (Layer 4 — ultra-glow filtered ellipse)",
                        "default": true
                      },
                      "radiatingRays": {
                        "type": "boolean",
                        "description": "Animated directional light rays fanning from the lens (Layer 5 — 6 animated lines at 30° intervals)",
                        "default": true
                      }
                    },
                    "default": {
                      "ambientHalo": true,
                      "lightCone": true,
                      "coreBeam": true,
                      "hotCenter": true,
                      "radiatingRays": true
                    }
                  },
                  "realWorldDisplayMode": {
                    "type": "string",
                    "description": "How to display real-world examples. 'carousel' shows one example at a time with Prev/Next navigation and dot indicators. 'grid' shows all examples in a responsive grid layout.",
                    "enum": [
                      "carousel",
                      "grid"
                    ],
                    "default": "carousel"
                  },
                  "initialRealWorldIndex": {
                    "type": "number",
                    "description": "Starting index (0-based) for the real-world carousel. Only applies when realWorldDisplayMode is 'carousel'.",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 5
                  },
                  "showDotIndicators": {
                    "type": "boolean",
                    "description": "Show/hide clickable dot indicators below the real-world carousel. Active dot stretches wider with gradient fill.",
                    "default": true
                  },
                  "showRealWorldNavButtons": {
                    "type": "boolean",
                    "description": "Show/hide circular Prev/Next navigation buttons flanking the real-world card in carousel mode",
                    "default": true
                  },
                  "showRealWorldCounter": {
                    "type": "boolean",
                    "description": "Show/hide the 'X of Y examples' counter text in real-world carousel mode",
                    "default": true
                  },
                  "realWorldAutoPlay": {
                    "type": "number",
                    "description": "Auto-advance interval in milliseconds for the real-world carousel (0 = disabled). When enabled, automatically cycles through examples.",
                    "default": 0,
                    "minimum": 0
                  },
                  "practiceQuestions": {
                    "type": "array",
                    "description": "Custom practice questions (overrides defaults)",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "question",
                        "options",
                        "correctAnswer"
                      ],
                      "properties": {
                        "id": {
                          "type": "number",
                          "description": "Question ID"
                        },
                        "question": {
                          "type": "string",
                          "description": "Question text"
                        },
                        "options": {
                          "type": "array",
                          "description": "Answer options",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 2,
                          "maxItems": 6
                        },
                        "correctAnswer": {
                          "type": "string",
                          "description": "Correct answer (must match one option exactly)"
                        }
                      }
                    },
                    "default": []
                  },
                  "realWorldCategories": {
                    "type": "array",
                    "description": "Custom real-world application categories (overrides defaults). Shown one at a time in carousel mode with animated circuit diagrams, descriptions, and example tags.",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "icon",
                        "title",
                        "description",
                        "examples",
                        "color"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Category ID"
                        },
                        "icon": {
                          "type": "string",
                          "description": "Emoji icon"
                        },
                        "title": {
                          "type": "string",
                          "description": "Category title"
                        },
                        "description": {
                          "type": "string",
                          "description": "Category description"
                        },
                        "examples": {
                          "type": "array",
                          "description": "Example items in this category",
                          "items": {
                            "type": "string"
                          }
                        },
                        "color": {
                          "type": "string",
                          "description": "CSS gradient or color"
                        }
                      }
                    },
                    "default": []
                  }
                },
                "examples": [
                  {
                    "description": "Torch starts ON",
                    "value": {
                      "torchState": "on"
                    }
                  },
                  {
                    "description": "Non-interactive demonstration",
                    "value": {
                      "torchState": "on",
                      "interactive": false
                    }
                  },
                  {
                    "description": "Show circuit diagram",
                    "value": {
                      "showCircuit": true
                    }
                  },
                  {
                    "description": "Highlight specific components",
                    "value": {
                      "highlightComponents": [
                        "lamp",
                        "switch"
                      ]
                    }
                  },
                  {
                    "description": "Custom torch colors",
                    "value": {
                      "customColors": {
                        "torchHead": "#facc15",
                        "torchBody": "#dc2626",
                        "switchColor": "#10b981"
                      }
                    }
                  },
                  {
                    "description": "High-intensity torch with all light layers",
                    "value": {
                      "torchState": "on",
                      "glowIntensity": 1,
                      "lightLayers": {
                        "ambientHalo": true,
                        "lightCone": true,
                        "coreBeam": true,
                        "hotCenter": true,
                        "radiatingRays": true
                      }
                    }
                  },
                  {
                    "description": "Minimal torch glow — only core beam",
                    "value": {
                      "torchState": "on",
                      "glowIntensity": 0.3,
                      "lightLayers": {
                        "ambientHalo": false,
                        "lightCone": false,
                        "coreBeam": true,
                        "hotCenter": false,
                        "radiatingRays": false
                      }
                    }
                  },
                  {
                    "description": "Real-world carousel starting at Transportation",
                    "value": {
                      "realWorldDisplayMode": "carousel",
                      "initialRealWorldIndex": 2,
                      "showDotIndicators": true,
                      "showRealWorldNavButtons": true
                    }
                  },
                  {
                    "description": "Real-world carousel without navigation controls",
                    "value": {
                      "realWorldDisplayMode": "carousel",
                      "showDotIndicators": false,
                      "showRealWorldNavButtons": false,
                      "showRealWorldCounter": false
                    }
                  },
                  {
                    "description": "Real-world auto-playing carousel",
                    "value": {
                      "realWorldDisplayMode": "carousel",
                      "realWorldAutoPlay": 5000,
                      "showDotIndicators": true
                    }
                  },
                  {
                    "description": "Custom circuit with battery",
                    "value": {
                      "showCircuit": true,
                      "circuitComponents": [
                        {
                          "id": "battery1",
                          "type": "battery",
                          "position": {
                            "x": 100,
                            "y": 200
                          },
                          "connections": [
                            "switch1"
                          ],
                          "state": "on"
                        },
                        {
                          "id": "switch1",
                          "type": "switch",
                          "position": {
                            "x": 250,
                            "y": 200
                          },
                          "connections": [
                            "battery1",
                            "led1"
                          ],
                          "state": "open"
                        },
                        {
                          "id": "led1",
                          "type": "led",
                          "position": {
                            "x": 400,
                            "y": 200
                          },
                          "connections": [
                            "switch1"
                          ],
                          "state": "off"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "instructions_for_student": {
        "type": "string",
        "description": "Additional instructions or context for the student"
      }
    },
    "required": [
      "frontend_action",
      "data"
    ],
    "examples": [
      {
        "description": "Basic learn mode - default configuration",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Learn About Torchlight Circuits",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "learn"
            }
          },
          "instructions_for_student": "Explore how a torchlight works! Click the torch to turn it on and off."
        }
      },
      {
        "description": "Practice mode only - no navigation",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Torchlight Circuit Quiz",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "practice",
              "showModeSelector": false,
              "showNavigation": false
            }
          },
          "instructions_for_student": "Test your knowledge about electric circuits!"
        }
      },
      {
        "description": "Torch demonstration - starts ON with intensified glow, non-interactive",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "How a Torch Lights Up",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "learn",
              "showModeSelector": false,
              "additionalProps": {
                "torchState": "on",
                "interactive": false,
                "showCircuit": true,
                "glowIntensity": 0.9,
                "lightLayers": {
                  "ambientHalo": true,
                  "lightCone": true,
                  "coreBeam": true,
                  "hotCenter": true,
                  "radiatingRays": true
                }
              }
            }
          },
          "instructions_for_student": "Notice how the electric current flows through the circuit when the switch is ON. See the 5 layers of light produced by the torch!"
        }
      },
      {
        "description": "Component focus - highlight lamp and switch",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Key Circuit Components",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "learn",
              "additionalProps": {
                "highlightComponents": [
                  "lamp",
                  "switch"
                ],
                "showCircuit": true
              }
            }
          },
          "instructions_for_student": "Pay special attention to the highlighted components - the lamp and switch!"
        }
      },
      {
        "description": "Real-world carousel - browse examples one at a time",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Electric Circuits in Daily Life",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "real_world",
              "showModeSelector": false,
              "enabledModes": [
                "real_world"
              ],
              "additionalProps": {
                "realWorldDisplayMode": "carousel",
                "initialRealWorldIndex": 0,
                "showDotIndicators": true,
                "showRealWorldNavButtons": true,
                "showRealWorldCounter": true
              }
            }
          },
          "instructions_for_student": "Use the Next and Previous buttons to explore how electric circuits are used in devices all around you!"
        }
      },
      {
        "description": "Real-world carousel starting at a specific category",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Circuits in Transportation",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "real_world",
              "showModeSelector": false,
              "additionalProps": {
                "realWorldDisplayMode": "carousel",
                "initialRealWorldIndex": 2,
                "showDotIndicators": true
              }
            }
          },
          "instructions_for_student": "Start with transportation circuits, then navigate to other real-world examples!"
        }
      },
      {
        "description": "Custom themed torch - orange/yellow theme with high intensity",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Safety Orange Torch",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "themeColor": "#f97316",
              "additionalProps": {
                "customColors": {
                  "torchHead": "#fbbf24",
                  "torchBody": "#f97316",
                  "switchColor": "#10b981"
                },
                "glowIntensity": 1,
                "lightLayers": {
                  "ambientHalo": true,
                  "lightCone": true,
                  "coreBeam": true,
                  "hotCenter": true,
                  "radiatingRays": true
                }
              }
            }
          },
          "instructions_for_student": "This torch has a special safety orange color with maximum brightness!"
        }
      },
      {
        "description": "Circuit with LED instead of lamp",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "LED Circuit",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "additionalProps": {
                "showCircuit": true,
                "circuitComponents": [
                  {
                    "id": "cell1",
                    "type": "cell",
                    "position": {
                      "x": 100,
                      "y": 200
                    },
                    "connections": [
                      "switch1"
                    ],
                    "state": "on"
                  },
                  {
                    "id": "switch1",
                    "type": "switch",
                    "position": {
                      "x": 250,
                      "y": 200
                    },
                    "connections": [
                      "cell1",
                      "led1"
                    ],
                    "state": "closed"
                  },
                  {
                    "id": "led1",
                    "type": "led",
                    "position": {
                      "x": 400,
                      "y": 200
                    },
                    "connections": [
                      "switch1"
                    ],
                    "state": "on"
                  }
                ]
              }
            }
          },
          "instructions_for_student": "Modern torches often use LED lights instead of traditional bulbs!"
        }
      },
      {
        "description": "Custom practice questions",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Circuit Basics Quiz",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "initialMode": "practice",
              "showModeSelector": false,
              "additionalProps": {
                "practiceQuestions": [
                  {
                    "id": 1,
                    "question": "What does a switch do in a circuit?",
                    "options": [
                      "Stores electricity",
                      "Controls the flow of electricity",
                      "Produces light",
                      "Generates electricity"
                    ],
                    "correctAnswer": "Controls the flow of electricity"
                  },
                  {
                    "id": 2,
                    "question": "What happens when you open a switch?",
                    "options": [
                      "Current stops flowing",
                      "Current flows faster",
                      "Battery gets stronger",
                      "Lamp gets brighter"
                    ],
                    "correctAnswer": "Current stops flowing"
                  }
                ]
              }
            }
          },
          "instructions_for_student": "Answer these questions about circuit basics!"
        }
      },
      {
        "description": "All modes enabled with intensified torch and carousel real-world",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Complete Circuit Learning Tool",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "showModeSelector": true,
              "enabledModes": [
                "learn",
                "practice",
                "real_world"
              ],
              "additionalProps": {
                "showCircuit": true,
                "glowIntensity": 0.8,
                "lightLayers": {
                  "ambientHalo": true,
                  "lightCone": true,
                  "coreBeam": true,
                  "hotCenter": true,
                  "radiatingRays": true
                },
                "realWorldDisplayMode": "carousel",
                "showDotIndicators": true,
                "showRealWorldNavButtons": true,
                "showRealWorldCounter": true
              }
            }
          },
          "instructions_for_student": "Explore all aspects of torchlight circuits - learn, practice, and browse real-world applications one by one!"
        }
      },
      {
        "description": "Minimal UI - focused learning",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Simple Torch Demo",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "showModeSelector": false,
              "showNavigation": false,
              "showStepIndicator": false,
              "additionalProps": {
                "torchState": "off",
                "interactive": true,
                "glowIntensity": 0.8
              }
            }
          },
          "instructions_for_student": "Click the torch to see what happens!"
        }
      },
      {
        "description": "Subtle torch glow - only core beam and hot center",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Soft Torch Demo",
          "data": {
            "toolName": "torchlight_circuit_tool",
            "parameters": {
              "showModeSelector": false,
              "additionalProps": {
                "torchState": "on",
                "glowIntensity": 0.4,
                "lightLayers": {
