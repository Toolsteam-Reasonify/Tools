        }
    },
    "changelog": {
        "v3.0.0": {
            "date": "2026-02-09",
            "changes": [
                "Redesigned with Singularity Design System (colors, typography, buttons, spacing)",
                "Made fully responsive with mobile/tablet/desktop breakpoints",
                "Replaced fixed width/height with fluid max-width layout",
                "Added gradient progress bar below header",
                "Updated header to three-stop purple-blue-orange gradient",
                "Changed buttons to pill-shaped style per design system",
                "Added DPR-aware canvas rendering for retina displays",
                "Proportional canvas scaling based on container dimensions",
                "Added themed cards for Real World (orange) and Hands-On (purple) modes",
                "Added icons to Real World and Hands-On step items",
