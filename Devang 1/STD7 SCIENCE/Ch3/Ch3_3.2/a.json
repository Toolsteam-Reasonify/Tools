                "Full viewport height layout",
                "Horizontally scrollable mode tabs",
                "Reduced padding and font sizes",
                "Smaller canvas height (200px vs 280px)",
                "Touch-friendly button sizing"
            ]
        },
        "designSystem": {
            "colorTokens": "Centralized TOKENS object for all design values",
            "typography": "Poppins font via Google Fonts CDN",
            "buttonStyle": "Pill-shaped (border-radius: 999px) matching Singularity Design System",
            "gradientHeader": "Three-stop gradient: #533086 → #4A4DC9 → #FC9145"
        },
        "animations": {
            "transitions": "CSS transitions on buttons, options, and navigation (0.25s ease)",
