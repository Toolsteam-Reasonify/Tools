{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sources of Light Interactive Tool",
  "description": "An interactive educational tool for teaching sources of light concepts from NCERT Curiosity Grade 7, Chapter 11.1",
  "type": "object",
  "properties": {
    "frontend_action": {
      "type": "string",
      "const": "show_interactive_tool"
    },
    "title": {
      "type": "string",
      "description": "Display title for the tool"
    },
    "data": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "const": "sources_of_light_tool"
        },
        "parameters": {
          "type": "object",
          "properties": {
            "width": {
              "type": ["number", "string"],
              "default": "100%",
              "description": "Width of the tool container (number for pixels, string for CSS value)"
            },
            "height": {
              "type": ["number", "string"],
              "default": "auto",
              "description": "Height of the tool container"
            },
            "minWidth": {
              "type": "number",
              "default": 300,
              "description": "Minimum width in pixels"
            },
            "maxWidth": {
              "type": "number",
              "default": 1200,
              "description": "Maximum width in pixels"
            },
            "initialMode": {
              "type": "string",
              "enum": ["learn", "practice", "real_world"],
              "default": "learn",
              "description": "Starting mode when tool loads"
            },
            "showModeSelector": {
              "type": "boolean",
              "default": true,
              "description": "Show/hide the mode selection tabs"
            },
            "enabledModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["learn", "practice", "real_world"]
              },
              "default": ["learn", "practice", "real_world"],
              "description": "Which modes to enable"
            },
            "showNavigation": {
              "type": "boolean",
              "default": true,
              "description": "Show/hide prev/next navigation buttons"
            },
            "showPlayPause": {
              "type": "boolean",
              "default": true,
              "description": "Show/hide auto-play button"
            },
            "showStepIndicator": {
              "type": "boolean",
              "default": true,
              "description": "Show/hide step counter (e.g., '1/6')"
            },
            "initialStep": {
              "type": "number",
              "default": 0,
              "description": "Starting step index (0-based)"
            },
            "filterSteps": {
              "type": "array",
              "items": { "type": "number" },
              "description": "Only show these step indices"
            },
            "animationSpeed": {
              "type": "number",
              "default": 1,
              "description": "Animation speed multiplier (0.5 = slow, 2 = fast)"
            },
            "autoPlayDuration": {
              "type": "number",
              "default": 8000,
              "description": "Auto-advance delay in milliseconds (0 to disable)"
            },
            "themeColor": {
              "type": "string",
              "default": "#3b82f6",
              "description": "Primary theme color (hex)"
            },
            "darkMode": {
              "type": "boolean",
              "default": true,
              "description": "Enable dark mode theme"
            },
            "responsive": {
              "type": "boolean",
              "default": true,
              "description": "Enable responsive layout"
            },
            "additionalProps": {
              "type": "object",
              "description": "Tool-specific dynamic content",
              "properties": {
                "learnContent": {
                  "type": "array",
                  "description": "Custom learning content sections",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "content": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "keyPoints": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "animationType": {
                        "type": "string",
                        "enum": ["lightTravel", "luminous", "nonLuminous", "natural", "artificial", "moonReflection"]
                      }
                    },
                    "required": ["id", "title", "content", "keyPoints", "animationType"]
                  }
                },
                "quizQuestions": {
                  "type": "array",
                  "description": "Custom quiz questions",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "question": { "type": "string" },
                      "options": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 4,
                        "maxItems": 4
                      },
                      "correctAnswer": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 3
                      },
                      "explanation": { "type": "string" }
                    },
                    "required": ["id", "question", "options", "correctAnswer", "explanation"]
                  }
                },
                "realWorldExamples": {
                  "type": "array",
                  "description": "Custom real-world examples",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "icon": {
                        "type": "string",
                        "enum": ["bulb", "firefly", "sun", "fish", "stars", "lamp"]
                      },
                      "description": { "type": "string" },
                      "funFact": { "type": "string" },
                      "location": { "type": "string" }
                    },
                    "required": ["id", "title", "icon", "description", "funFact"]
                  }
                },
                "highlightTopic": {
                  "type": "string",
                  "description": "Topic to emphasize (e.g., 'luminous', 'moon')"
                },
                "showAnimations": {
                  "type": "boolean",
                  "default": true,
                  "description": "Show/hide animated visualizations"
                },
                "animationIntensity": {
                  "type": "number",
                  "default": 1,
                  "minimum": 0,
                  "maximum": 2,
                  "description": "Intensity of animations (0-2)"
                }
              }
            }
          }
        }
      },
      "required": ["toolName", "parameters"]
    },
    "instructions_for_student": {
      "type": "string",
      "description": "Instructions or context to show the student"
    }
  },
  "required": ["frontend_action", "title", "data"],

  "examples": [
    {
      "title": "Example 1: Default Learn Mode",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Sources of Light",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "learn",
            "showModeSelector": true
          }
        },
        "instructions_for_student": "Learn about different sources of light!"
      }
    },
    {
      "title": "Example 2: Practice Quiz Only",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Light Sources Quiz",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "practice",
            "showModeSelector": false,
            "enabledModes": ["practice"]
          }
        },
        "instructions_for_student": "Test your knowledge about light sources!"
      }
    },
    {
      "title": "Example 3: Real World Examples",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Light in the Real World",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "real_world",
            "enabledModes": ["real_world"],
            "showModeSelector": false
          }
        },
        "instructions_for_student": "Discover how light sources impact our daily lives!"
      }
    },
    {
      "title": "Example 4: Focus on Luminous Objects",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Luminous Objects",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "learn",
            "initialStep": 1,
            "filterSteps": [1],
            "showNavigation": false,
            "additionalProps": {
              "highlightTopic": "luminous"
            }
          }
        },
        "instructions_for_student": "Let's learn about objects that emit their own light!"
      }
    },
    {
      "title": "Example 5: Moon Reflection Explanation",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Why Does the Moon Shine?",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "learn",
            "initialStep": 5,
            "filterSteps": [5],
            "showModeSelector": false,
            "showNavigation": false
          }
        },
        "instructions_for_student": "The Moon doesn't make its own light - it reflects sunlight!"
      }
    },
    {
      "title": "Example 6: Minimal UI Demo",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Light Demo",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "showModeSelector": false,
            "showNavigation": false,
            "showPlayPause": false,
            "showStepIndicator": false,
            "autoPlayDuration": 0,
            "initialStep": 0
          }
        },
        "instructions_for_student": "Light is a form of energy that helps us see!"
      }
    },
    {
      "title": "Example 7: Dark Mode Disabled",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Sources of Light",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "darkMode": false,
            "themeColor": "#16a34a"
          }
        },
        "instructions_for_student": "Explore light sources in light mode!"
      }
    },
    {
      "title": "Example 8: Custom Quiz Questions",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Custom Light Quiz",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "practice",
            "additionalProps": {
              "quizQuestions": [
                {
                  "id": "custom1",
                  "question": "What is the main natural source of light on Earth?",
                  "options": ["Moon", "Stars", "Sun", "Fire"],
                  "correctAnswer": 2,
                  "explanation": "The Sun is our main natural light source, providing light and energy for life on Earth."
                },
                {
                  "id": "custom2",
                  "question": "Which insect produces its own light?",
                  "options": ["Butterfly", "Firefly", "Mosquito", "Beetle"],
                  "correctAnswer": 1,
                  "explanation": "Fireflies are bioluminescent insects that produce light through chemical reactions."
                }
              ]
            }
          }
        },
        "instructions_for_student": "Answer these questions about light!"
      }
    },
    {
      "title": "Example 9: Slow Animations",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Sources of Light (Slow)",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "animationSpeed": 0.5,
            "autoPlayDuration": 12000
          }
        },
        "instructions_for_student": "Watch the animations carefully to understand how light works!"
      }
    },
    {
      "title": "Example 10: Indian Context Focus",
      "value": {
        "frontend_action": "show_interactive_tool",
        "title": "Light in India",
        "data": {
          "toolName": "sources_of_light_tool",
          "parameters": {
            "initialMode": "real_world",
            "additionalProps": {
              "realWorldExamples": [
                {
                  "id": "ujala",
                  "title": "UJALA LED Scheme",
                  "icon": "bulb",
                  "description": "Government initiative that distributed 360+ million LED bulbs across India.",
                  "funFact": "UJALA stands for Unnat Jyoti by Affordable LEDs for All!",
                  "location": "India"
                },
                {
                  "id": "diwali",
                  "title": "Diwali - Festival of Lights",
                  "icon": "lamp",
                  "description": "India's biggest festival celebrating the victory of light over darkness.",
                  "funFact": "Diwali is celebrated by lighting millions of diyas (oil lamps) across the country!",
                  "location": "India"
                },
                {
                  "id": "bhadla",
                  "title": "Bhadla Solar Park",
                  "icon": "sun",
                  "description": "One of the world's largest solar power plants in Rajasthan.",
                  "funFact": "It covers 14,000 acres - that's about 10,000 football fields!",
                  "location": "Rajasthan, India"
                }
              ]
            }
          }
        },
        "instructions_for_student": "Learn about light sources in India!"
      }
    }
  ]
}