{
  "tool_name": "sources_of_light_learn_mode",
  "version": "1.0.0",
  "description": "Interactive educational tool for teaching Grade 7 students about sources of light, luminous and non-luminous objects with smooth animations",
  "category": "science_physics",
  "grade_level": 7,
  "curriculum": "NCERT India - Grade 7 Science - Chapter 11: Light: Shadows and Reflections - Section 11.1",
  
  "schema": {
    "type": "object",
    "properties": {
      "width": {
        "type": "number",
        "default": 900,
        "description": "Width of the component in pixels"
      },
      "height": {
        "type": "number",
        "default": 700,
        "description": "Height of the component in pixels"
      },
      "initialMode": {
        "type": "string",
        "enum": ["learn", "practice", "explore"],
        "default": "learn",
        "description": "Starting mode of the tool"
      },
      "showModeSelector": {
        "type": "boolean",
        "default": true,
        "description": "Show/hide mode selection tabs"
      },
      "enabledModes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["learn", "practice", "explore"]
        },
        "default": ["learn", "practice", "explore"],
        "description": "Which modes to enable"
      },
      "showNavigation": {
        "type": "boolean",
        "default": true,
        "description": "Show/hide previous/next buttons"
      },
      "showPlayPause": {
        "type": "boolean",
        "default": true,
        "description": "Show/hide play/pause button"
      },
      "showStepIndicator": {
        "type": "boolean",
        "default": true,
        "description": "Show/hide step counter (e.g., '3/10')"
      },
      "initialStep": {
        "type": "number",
        "default": 1,
        "description": "Starting step number (1-indexed)"
      },
      "filterSteps": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "description": "Only show these step IDs (1-10 for learn mode)"
      },
      "animationSpeed": {
        "type": "number",
        "default": 1,
        "description": "Animation speed multiplier (0.5 = slower, 2 = faster)"
      },
      "autoPlayDuration": {
        "type": "number",
        "default": 8000,
        "description": "Auto-advance delay in milliseconds (0 to disable)"
      },
      "themeColor": {
        "type": "string",
        "default": "#f59e0b",
        "description": "Primary theme color (hex code)"
      },
      "darkMode": {
        "type": "boolean",
        "default": false,
        "description": "Enable dark mode"
      },
      "additionalProps": {
        "type": "object",
        "properties": {
          "highlightSources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["sun", "stars", "firefly", "lightning", "fire", "led", "moon"]
            },
            "description": "Which light sources to emphasize"
          },
          "showDefinitions": {
            "type": "boolean",
            "default": true,
            "description": "Show definitions of key terms"
          },
          "emphasizeLuminous": {
            "type": "boolean",
            "default": false,
            "description": "Emphasize luminous vs non-luminous distinction"
          },
          "customExamples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the example object"
                },
                "type": {
                  "type": "string",
                  "enum": ["luminous", "non-luminous"],
                  "description": "Whether object is luminous or non-luminous"
                },
                "description": {
                  "type": "string",
                  "description": "Brief description of the object"
                }
              }
            },
            "description": "Custom examples to add to the explore mode"
          }
        }
      }
    }
  },

  "learn_mode_steps": [
    {
      "id": 1,
      "title": "Introduction to Light",
      "topics": ["What is light", "Importance of light", "Types of light sources"]
    },
    {
      "id": 2,
      "title": "Natural Sources of Light",
      "topics": ["Sun", "Stars", "Lightning", "Fireflies", "Bioluminescence"]
    },
    {
      "id": 3,
      "title": "The Sun - Our Primary Light Source",
      "topics": ["Sun as main light source", "Energy from the Sun"]
    },
    {
      "id": 4,
      "title": "Artificial Light - Fire",
      "topics": ["Fire as earliest artificial light", "Different fuels"]
    },
    {
      "id": 5,
      "title": "Modern Electric Lighting",
      "topics": ["Invention of electricity", "Electric light sources"]
    },
    {
      "id": 6,
      "title": "Luminous Objects",
      "topics": ["Definition", "Examples", "Characteristics"]
    },
    {
      "id": 7,
      "title": "Non-Luminous Objects",
      "topics": ["Definition", "Examples", "How they're visible"]
    },
    {
      "id": 8,
      "title": "The Moon - A Non-Luminous Object",
      "topics": ["Moon doesn't emit light", "Reflects sunlight", "Moonlight explained"]
    },
    {
      "id": 9,
      "title": "LED Technology",
      "topics": ["Energy efficiency", "Environmental benefits", "Proper disposal"]
    },
    {
      "id": 10,
      "title": "Summary",
      "topics": ["Review of all concepts"]
    }
  ],

  "practice_questions": [
    "Identify luminous vs non-luminous objects",
    "Classify natural vs artificial light sources",
    "Understand Moon's reflection",
    "Benefits of LED technology",
    "Real-world applications"
  ],

  "agent_examples": [
    {
      "use_case": "General introduction to light sources",
      "student_query": "What are sources of light?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Sources of Light",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "showModeSelector": true
          }
        },
        "instructions_for_student": "Let's explore different sources of light and understand how light works!"
      }
    },
    {
      "use_case": "Focus on natural light sources",
      "student_query": "Tell me about natural sources of light",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Natural Sources of Light",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [2, 3],
            "additionalProps": {
              "highlightSources": ["sun", "stars", "lightning", "firefly"]
            }
          }
        },
        "instructions_for_student": "Discover the amazing natural sources of light in our world!"
      }
    },
    {
      "use_case": "Explain luminous objects",
      "student_query": "What are luminous objects?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Luminous Objects",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [6],
            "additionalProps": {
              "emphasizeLuminous": true,
              "showDefinitions": true
            }
          }
        },
        "instructions_for_student": "Learn about objects that emit their own light!"
      }
    },
    {
      "use_case": "Moon and reflection question",
      "student_query": "Does the Moon make its own light?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "The Moon - A Non-Luminous Object",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [8],
            "showModeSelector": false,
            "additionalProps": {
              "highlightSources": ["moon", "sun"],
              "showDefinitions": true
            }
          }
        },
        "instructions_for_student": "Discover why the Moon shines and learn about reflected light!"
      }
    },
    {
      "use_case": "LED technology inquiry",
      "student_query": "What are LED lamps? Why are they better?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "LED Technology",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [5, 9],
            "additionalProps": {
              "highlightSources": ["led"]
            }
          }
        },
        "instructions_for_student": "Learn about modern, energy-efficient LED lighting!"
      }
    },
    {
      "use_case": "Practice/test knowledge",
      "student_query": "Can you test me on light sources?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Light Sources Quiz",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "practice",
            "showModeSelector": false,
            "enabledModes": ["practice"]
          }
        },
        "instructions_for_student": "Test your knowledge about sources of light!"
      }
    },
    {
      "use_case": "Free exploration mode",
      "student_query": "I want to explore different light sources",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Explore Light Sources",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "explore",
            "showModeSelector": false
          }
        },
        "instructions_for_student": "Explore different light sources at your own pace!"
      }
    },
    {
      "use_case": "Auto-play presentation mode",
      "student_query": "Show me a presentation about light sources",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Sources of Light Presentation",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "showModeSelector": false,
            "showNavigation": false,
            "autoPlayDuration": 6000,
            "showPlayPause": true
          }
        },
        "instructions_for_student": "Watch this presentation about sources of light!"
      }
    },
    {
      "use_case": "Compare natural vs artificial",
      "student_query": "What's the difference between natural and artificial light?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Natural vs Artificial Light",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [2, 4, 5],
            "additionalProps": {
              "highlightSources": ["sun", "fire", "led"]
            }
          }
        },
        "instructions_for_student": "Compare natural and artificial sources of light!"
      }
    },
    {
      "use_case": "Custom examples mode",
      "student_query": "Are flashlights and mirrors luminous?",
      "tool_call": {
        "frontend_action": "show_interactive_tool",
        "title": "Luminous vs Non-Luminous Objects",
        "data": {
          "toolName": "sources_of_light_learn_mode",
          "parameters": {
            "initialMode": "learn",
            "filterSteps": [6, 7],
            "additionalProps": {
              "showDefinitions": true,
              "emphasizeLuminous": true,
              "customExamples": [
                {
                  "name": "Flashlight",
                  "type": "luminous",
                  "description": "Battery-powered device that emits light"
                },
                {
                  "name": "Mirror",
                  "type": "non-luminous",
                  "description": "Reflects light but doesn't emit its own"
                }
              ]
            }
          }
        },
        "instructions_for_student": "Learn about luminous and non-luminous objects with examples!"
      }
    }
  ],

  "agent_decision_tree": {
    "student_asks_about_light": {
      "general_question": {
        "triggers": ["what is light", "sources of light", "types of light"],
        "action": "Use initialMode: 'learn', showModeSelector: true"
      },
      "natural_sources": {
        "triggers": ["natural light", "sun", "stars", "lightning", "fireflies"],
        "action": "Use filterSteps: [2, 3], highlightSources: ['sun', 'stars', 'lightning', 'firefly']"
      },
      "artificial_sources": {
        "triggers": ["artificial light", "electric light", "bulbs", "fire"],
        "action": "Use filterSteps: [4, 5], highlightSources: ['fire', 'led']"
      },
      "luminous_objects": {
        "triggers": ["luminous", "emit light", "glow", "shine"],
        "action": "Use filterSteps: [6], emphasizeLuminous: true, showDefinitions: true"
      },
      "non_luminous_objects": {
        "triggers": ["non-luminous", "don't emit light", "reflect light"],
        "action": "Use filterSteps: [7], showDefinitions: true"
      },
      "moon_question": {
        "triggers": ["moon", "moonlight", "does moon make light"],
        "action": "Use filterSteps: [8], highlightSources: ['moon', 'sun']"
      },
      "led_technology": {
        "triggers": ["led", "energy efficient", "modern lighting"],
        "action": "Use filterSteps: [9], highlightSources: ['led']"
      },
      "test_knowledge": {
        "triggers": ["quiz", "test", "practice", "questions"],
        "action": "Use initialMode: 'practice'"
      },
      "explore": {
        "triggers": ["explore", "look around", "see all"],
        "action": "Use initialMode: 'explore'"
      }
    }
  },

  "animation_features": {
    "sun": "Rotating rays with glowing pulse effect",
    "stars": "Random twinkling with scale and opacity changes",
    "firefly": "Gaussian blur glow with pulsing animation",
    "lightning": "Flash animation with SVG lightning bolt",
    "fire": "Flickering flame with multiple layers",
    "led": "Pulsing glow effect with modern design",
    "moon": "Reflection visualization with light beam from sun",
    "transitions": "Smooth fade and slide between steps",
    "interactions": "Hover effects with scale and shadow changes"
  },

  "accessibility": {
    "keyboard_navigation": true,
    "screen_reader_friendly": true,
    "focus_indicators": true,
    "aria_labels": true
  },

  "performance": {
    "fps": 60,
    "animation_optimization": "GPU-accelerated transforms",
    "memory_management": "Efficient cleanup of animations"
  },

  "browser_support": {
    "chrome": "90+",
    "firefox": "88+",
    "safari": "14+",
    "edge": "90+"
  },

  "tips_for_agents": [
    "For single topic focus: Use filterSteps with specific step IDs",
    "For minimal distractions: Set showModeSelector: false, showNavigation: false",
    "For auto-presentation: Use autoPlayDuration with showPlayPause",
    "For specific emphasis: Use highlightSources in additionalProps",
    "For custom context: Use customExamples to add relevant objects",
    "For quick quiz: Use initialMode: 'practice' with enabledModes: ['practice']",
    "For exploration: Use initialMode: 'explore' for free navigation"
  ],

  "educational_outcomes": [
    "Understand difference between luminous and non-luminous objects",
    "Identify natural and artificial sources of light",
    "Explain why the Moon appears bright at night",
    "Recognize the importance of the Sun as primary light source",
    "Appreciate modern LED technology and its benefits",
    "Apply knowledge to classify everyday objects"
  ]
}
