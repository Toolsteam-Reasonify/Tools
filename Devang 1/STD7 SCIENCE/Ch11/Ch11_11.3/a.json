{
  "toolName": "light_through_transparent_translucent_and_opaque_materials",
  "parameters": {
    "width": {
      "type": "number",
      "default": 900,
      "description": "Canvas width in pixels",
      "min": 600,
      "max": 1400
    },
    "height": {
      "type": "number",
      "default": 700,
      "description": "Canvas height in pixels",
      "min": 400,
      "max": 1000
    },
    "initialMode": {
      "type": "string",
      "enum": [
        "learn",
        "practice",
        "real_world",
        "hands_on"
      ],
      "default": "learn",
      "description": "Starting mode when component loads"
    },
    "showModeSelector": {
      "type": "boolean",
      "default": true,
      "description": "Display mode selection tabs"
    },
    "enabledModes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "learn",
          "practice",
          "real_world",
          "hands_on"
        ]
      },
      "default": [
        "learn",
        "practice",
        "real_world",
        "hands_on"
      ],
      "description": "Which modes are available to students"
    },
    "showNavigation": {
      "type": "boolean",
      "default": true,
      "description": "Show previous/next navigation buttons"
    },
    "showPlayPause": {
      "type": "boolean",
      "default": true,
      "description": "Show play/pause button for auto-advance"
    },
    "showStepIndicator": {
      "type": "boolean",
      "default": true,
      "description": "Show current step number display"
    },
    "initialStep": {
      "type": "number",
      "default": 1,
      "description": "Starting step ID",
      "min": 1,
      "max": 20
    },
    "filterSteps": {
      "type": "array",
      "items": {
        "type": "number",
        "min": 1,
        "max": 20
      },
      "default": null,
      "description": "Array of step IDs to display. If null, shows all steps."
    },
    "animationSpeed": {
      "type": "number",
      "default": 1,
      "description": "Animation speed multiplier",
      "min": 0.1,
      "max": 3
    },
    "autoPlayDuration": {
      "type": "number",
      "default": 8000,
      "description": "Milliseconds before auto-advancing to next step",
      "min": 0,
      "max": 30000
    },
    "themeColor": {
      "type": "string",
      "default": "#0891b2",
      "description": "Primary theme color (cyan/teal for Reasonify brand)",
      "examples": [
        "#0891b2",
        "#3b82f6",
        "#8b5cf6"
      ]
    },
    "darkMode": {
      "type": "boolean",
      "default": false,
      "description": "Enable dark theme"
    },
    "additionalProps": {
      "type": "object",
      "description": "Tool-specific configuration for light and materials",
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "glass",
              "clear_plastic",
              "water",
              "air",
              "tracing_paper",
              "frosted_glass",
              "thin_cloth",
              "wax_paper",
              "tissue",
              "cardboard",
              "metal_sheet",
              "wood",
              "thick_cloth",
              "book",
              "brick",
              "concrete"
            ]
          },
          "default": [
            "glass",
            "paper",
            "cardboard",
            "tracing_paper",
            "cloth",
            "plastic_bottle",
            "metal_sheet"
          ],
          "description": "Specific materials to demonstrate",
          "categories": {
            "transparent": [
              "glass",
              "clear_plastic",
              "water",
              "air"
            ],
            "translucent": [
              "tracing_paper",
              "frosted_glass",
              "thin_cloth",
              "wax_paper",
              "tissue"
            ],
            "opaque": [
              "cardboard",
              "metal_sheet",
              "wood",
              "thick_cloth",
              "book",
              "brick",
              "concrete"
            ]
          }
        },
        "showTable": {
          "type": "boolean",
          "default": true,
          "description": "Display NCERT Table 11.1 format for predictions vs observations",
          "table_format": {
            "columns": [
              "Material",
              "Transparent/Translucent/Opaque",
              "My prediction",
              "My observation"
            ],
            "rows": "Dynamic based on materials selected"
          }
        },
        "highlightBeam": {
          "type": "boolean",
          "default": true,
          "description": "Visual emphasis on light beam path with glow effects and intensity indicators"
        },
        "showParticles": {
          "type": "boolean",
          "default": true,
          "description": "Animated light particles showing transmission, scattering, or blocking",
          "particle_behavior": {
            "transparent": "Particles flow smoothly through (90-100% pass)",
            "translucent": "Particles scatter and partially pass (30-60% pass)",
            "opaque": "Particles bounce back or absorbed (0% pass)"
          }
        },
        "enableInteraction": {
          "type": "boolean",
          "default": null,
          "description": "Allow dragging materials into light path (auto-enabled in hands_on mode)"
        },
        "showClassification": {
          "type": "boolean",
          "default": true,
          "description": "Display material categories with icons (✓✓, ✓~, ✗)"
        },
        "beamColor": {
          "type": "string",
          "default": "#fbbf24",
          "description": "Color of torch light beam (hex format)",
          "examples": [
            {
              "value": "#fbbf24",
              "name": "Warm yellow",
              "use": "Torch light (default)"
            },
            {
              "value": "#ffffff",
              "name": "White",
              "use": "Bright LED light"
            },
            {
              "value": "#22c55e",
              "name": "Green",
              "use": "Green laser pointer"
            }
          ]
        },
        "showPercentage": {
          "type": "boolean",
          "default": false,
          "description": "Display numerical % of light transmission for quantitative learning"
        }
      },
      "examples": [
        {
          "name": "Complete NCERT Experience",
          "description": "Full demonstration matching Activity 11.3",
          "value": {
            "showTable": true,
            "highlightBeam": true,
            "showParticles": true,
            "showClassification": true,
            "materials": [
              "cardboard",
              "paper",
              "glass",
              "tracing_paper",
              "thick_cloth"
            ]
          }
        },
        {
          "name": "Transparent Materials Focus",
          "description": "Only transparent materials demonstration",
          "value": {
            "materials": [
              "glass",
              "clear_plastic",
              "water"
            ],
            "highlightBeam": true,
            "showPercentage": true,
            "showClassification": true
          }
        },
        {
          "name": "Translucent Materials Focus",
          "description": "Only translucent materials demonstration",
          "value": {
            "materials": [
              "tracing_paper",
              "frosted_glass",
              "thin_cloth",
              "wax_paper"
            ],
            "showParticles": true,
            "highlightBeam": true
          }
        },
        {
          "name": "Opaque Materials Focus",
          "description": "Only opaque materials demonstration",
          "value": {
            "materials": [
              "cardboard",
              "metal_sheet",
              "wood",
              "book"
            ],
            "highlightBeam": true,
            "showParticles": true
          }
        },
        {
          "name": "Interactive Lab",
          "description": "Full hands-on experimentation",
          "value": {
            "enableInteraction": true,
            "showPercentage": true,
            "showTable": true,
            "showParticles": true,
            "highlightBeam": true
          }
        },
        {
          "name": "Quick Comparison",
          "description": "Fast comparison of all three types",
          "value": {
            "materials": [
              "glass",
              "tracing_paper",
              "cardboard"
            ],
            "highlightBeam": true,
            "showClassification": true,
            "showPercentage": true
          }
        },
        {
          "name": "Assessment Mode",
          "description": "Testing without hints",
          "value": {
            "showClassification": false,
            "showPercentage": false,
            "enableInteraction": true,
            "highlightBeam": false
          }
        },
        {
          "name": "Quantitative Learning",
          "description": "With numerical measurements",
          "value": {
            "showPercentage": true,
            "showParticles": true,
            "highlightBeam": true,
            "showTable": true
          }
        }
      ]
    }
  },
  "usage_example": {}
}