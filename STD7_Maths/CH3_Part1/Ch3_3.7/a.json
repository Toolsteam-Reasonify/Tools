{
    "toolName": "decimal_add_sub_tool",
    "version": "1.0.0",
    "description": "Interactive tool for learning, practicing, and applying decimal addition and subtraction. Based on NCERT Ganita Prakash Grade 7 Chapter 3.7. Supports column-wise computation visualization with carry/borrow animations, place value alignment highlighting, practice problems with scoring, and real-world contexts (shopping, measurement, weight, money).",
    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Width of the tool in pixels"
        },
        "height": {
            "type": "number",
            "default": 600,
            "description": "Height of the tool in pixels"
        },
        "initialMode": {
            "type": "string",
            "enum": ["learn", "practice", "real_world"],
            "default": "learn",
            "description": "Starting mode for the tool"
        },
        "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide mode tabs"
        },
        "enabledModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["learn", "practice", "real_world"] },
            "default": ["learn", "practice", "real_world"],
            "description": "Which modes to enable"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide prev/next navigation"
        },
        "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide auto-play button"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide step counter"
        },
        "initialStep": {
            "type": "number",
            "description": "Starting step ID"
        },
        "filterSteps": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Only show these step IDs"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier"
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 10000,
            "description": "Auto-advance delay in ms (0 = disabled)"
        },
        "themeColor": {
            "type": "string",
            "default": "#3b82f6",
            "description": "Primary theme color"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode"
        }
    },
    "additionalProps": {
        "description": "Tool-specific dynamic content for decimal operations",
        "properties": {
            "number1": {
                "type": "number",
                "description": "First number for the operation (overrides step data)",
                "examples": [2.7, 75.345, 0.934]
            },
            "number2": {
                "type": "number",
                "description": "Second number for the operation (overrides step data)",
                "examples": [3.5, 86.691, 0.6]
            },
            "operation": {
                "type": "string",
                "enum": ["add", "subtract"],
                "description": "Operation to perform"
            },
            "showPlaceValue": {
                "type": "boolean",
                "default": true,
                "description": "Show place value breakdown"
            },
            "showCarryBorrow": {
                "type": "boolean",
                "default": true,
                "description": "Show carry/borrow indicators"
            },
            "highlightDecimalPoint": {
                "type": "boolean",
                "default": true,
                "description": "Highlight decimal point alignment"
            },
            "maxDecimalPlaces": {
                "type": "number",
                "default": 3,
                "description": "Max decimal places to display"
            },
            "practiceProblems": {
                "type": "array",
                "description": "Custom practice problems",
                "items": {
                    "type": "object",
                    "properties": {
                        "num1": { "type": "number" },
                        "num2": { "type": "number" },
                        "op": { "type": "string", "enum": ["add", "subtract"] }
                    }
                }
            },
            "difficulty": {
                "type": "string",
                "enum": ["easy", "medium", "hard"],
                "default": "medium",
                "description": "Difficulty level for practice mode"
            },
            "realWorldContext": {
                "type": "string",
                "enum": ["shopping", "measurement", "weight", "money"],
                "description": "Context for real-world mode"
            },
            "currency": {
                "type": "string",
                "default": "₹",
                "description": "Currency symbol for money context"
            },
            "unit": {
                "type": "string",
                "description": "Unit of measurement (m, cm, kg, L, etc.)"
            }
        },
        "examples": {
            "basic_addition": {
                "number1": 2.7,
                "number2": 3.5,
                "operation": "add"
            },
            "basic_subtraction": {
                "number1": 5.6,
                "number2": 2.3,
                "operation": "subtract"
            },
            "three_decimal_addition": {
                "number1": 75.345,
                "number2": 86.691,
                "operation": "add",
                "highlightDecimalPoint": true
            },
            "money_context": {
                "number1": 25.50,
                "number2": 14.75,
                "operation": "add",
                "realWorldContext": "money",
                "currency": "₹"
            },
            "measurement_context": {
                "number1": 2.7,
                "number2": 3.5,
                "operation": "add",
                "realWorldContext": "measurement",
                "unit": "m"
            }
        }
    },
    "modes": {
        "learn": {
            "label": "Learn",
            "description": "Step-by-step animated explanation of decimal addition and subtraction with column-wise visualization",
            "stepIds": [1, 2, 3, 4, 5]
        },
        "practice": {
            "label": "Practice",
            "description": "Interactive practice problems with scoring and instant feedback",
            "stepIds": [10, 11, 12, 13, 14]
        },
        "real_world": {
            "label": "Real World",
            "description": "Real-world applications: cloth shopping, grocery weight, milk supply, weight tracking",
            "stepIds": [20, 21, 22, 23]
        }
    },
    "steps": {
        "learn": [
            { "id": 1, "title": "Adding Decimals — Basics", "focus": "Line up decimal points" },
            { "id": 2, "title": "Place Value Alignment", "focus": "Units, tenths, hundredths alignment" },
            { "id": 3, "title": "Carrying Over in Decimals", "focus": "Carry when sum >= 10" },
            { "id": 4, "title": "Subtracting Decimals", "focus": "Subtraction with decimal alignment" },
            { "id": 5, "title": "Borrowing in Decimals", "focus": "Borrow from next column" }
        ],
        "practice": [
            { "id": 10, "title": "Easy Addition", "problem": "5.3 + 2.6" },
            { "id": 11, "title": "Addition with Carrying", "problem": "9.01 + 9.10" },
            { "id": 12, "title": "Easy Subtraction", "problem": "5.6 - 2.3" },
            { "id": 13, "title": "Subtraction with Borrowing", "problem": "18 - 8.8" },
            { "id": 14, "title": "Three Decimal Places", "problem": "6.236 + 0.487" }
        ],
        "real_world": [
            { "id": 20, "title": "Cloth Shopping", "context": "measurement" },
            { "id": 21, "title": "Grocery Shopping", "context": "weight" },
            { "id": 22, "title": "Weight Change", "context": "weight" },
            { "id": 23, "title": "Milk Supply", "context": "measurement" }
        ]
    }
}