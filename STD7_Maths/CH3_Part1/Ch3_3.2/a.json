  "common_issues": {
    "animation_not_playing": {
      "cause": "CSS animations disabled or browser incompatibility",
      "solution": "Check browser support, verify animationDuration > 0"
    },
    "incorrect_progress": {
      "cause": "State management issue",
      "solution": "Ensure setStepDetails callback is properly configured"
    },
    "layout_breaking": {
      "cause": "Viewport too narrow or CSS conflicts",
      "solution": "Test responsive breakpoints, check for CSS specificity issues"
    },
    "custom_content_not_showing": {
      "cause": "Incorrect prop format",
      "solution": "Verify customQuestions/customScenarios match interface exactly"
    }
  },
  
