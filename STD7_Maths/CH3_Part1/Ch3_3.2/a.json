{
  "tool_name": "TenthPartTool",
  "topic": "3.2 A Tenth Part",
  "subject": "Mathematics",
  "grade": 7,
  "curriculum": "Ganita Prakash",
  "design_system": "Singularity",
  "version": "1.0.0",
  
  "description": "Interactive learning tool for understanding tenth parts, converting between mixed numbers and improper fractions, and applying tenth concepts to real-world measurements.",
  
  "learning_objectives": [
    "Understand that one unit can be divided into 10 equal parts (tenths)",
    "Recognize that 10 × 1/10 = 1 whole unit",
    "Convert between mixed numbers (3 4/10) and improper fractions (34/10)",
    "Read and write fractional notation correctly",
    "Apply tenth concepts to real-world measurement scenarios"
  ],
  
  "tool_structure": {
    "modes": {
      "learn": {
        "name": "Learn Mode",
        "icon": "📚",
        "steps": 5,
        "description": "Visual lessons with interactive demonstrations",
        "topics": [
          "Understanding a Tenth Part",
          "Ten One-Tenths Make One Unit",
          "Converting 34 One-Tenths",
          "Reading Decimal Numbers",
          "The Math Behind Tenths"
        ]
      },
      "practice": {
        "name": "Practice Mode",
        "icon": "🧠",
        "questions": 5,
        "description": "Multiple-choice questions with immediate feedback",
        "scoring": true
      },
      "real_world": {
        "name": "Real World Mode",
        "icon": "🌍",
        "scenarios": 4,
        "description": "Practical applications of tenths",
        "topics": [
          "Measuring Fabric",
          "Pouring Juice",
          "Running Track",
          "Digital Scale"
        ]
      }
    },
    
    "visual_components": [
      {
        "name": "PencilWithRuler",
        "purpose": "Show measurement of 3 4/10 units",
        "demonstrates": "Reading fractional measurements on ruler"
      },
      {
        "name": "TenthsVisualization",
        "purpose": "Show 10 blocks representing tenths",
        "demonstrates": "10 × 1/10 = 1 unit"
      },
      {
        "name": "ConversionDiagram",
        "purpose": "Show conversion flow",
        "demonstrates": "34 × 1/10 → 34/10 → 3 + 4/10"
      },
      {
        "name": "TenthsNumberLine",
        "purpose": "Show tenths on number line",
        "demonstrates": "Locating fractional values"
      },
      {
        "name": "EquationBreakdown",
        "purpose": "Show step-by-step math",
        "demonstrates": "Algebraic decomposition"
      }
    ]
  },
  
