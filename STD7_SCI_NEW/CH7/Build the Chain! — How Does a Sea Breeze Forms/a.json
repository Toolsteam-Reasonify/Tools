{
    "toolName": "sea_breeze_sequencing_tool",
    "version": "2.0.0",
    "description": "Interactive sequencing tool for Grade 7 Science (Ch.7: Heat Transfer in Nature). Seven shuffled step cards for sea breeze formation. Styled with Singularity Design System: Poppins font, #4A4DC9 indigo, #FF7212 orange, #533086 purple, pill buttons, circle shape tokens.",
    "designSystem": "Singularity",
    "designTokens": {
        "font": "Poppins",
        "primary": "#4A4DC9",
        "accent": "#FF7212",
        "secondary": "#533086",
        "primaryLight": "#C1C1EA",
        "accentLight": "#FFF3E4",
        "grays": [
            "#4E4E4E",
            "#CACACA",
            "#EBEBEB",
            "#F5F5F5"
        ],
        "buttonStyle": "pill (border-radius: 100px)",
        "cardRadius": "12px",
        "containerRadius": "20px"
    },
    "subject": "Science",
    "grade": "Grade 7",
    "chapter": "Chapter 7 — Heat Transfer in Nature",
    "topic": "Sea Breeze Formation (Section 7.2.1)",
    "curriculum": "NCERT Curiosity Textbook",
    "parameters": {
        "width": {
            "type": "number",
            "default": 800
        },
        "height": {
            "type": "number",
            "default": 600
        },
        "themeColor": {
            "type": "string",
            "default": "#4A4DC9"
        },
        "darkMode": {
            "type": "boolean",
            "default": false
        },
        "animationSpeed": {
            "type": "number",
            "default": 1
        }
    },
    "additionalProps": {
        "schema": {
            "steps": {
                "type": "array",
                "description": "7 steps with id, text, hint, emoji",
                "default": [
                    {
                        "id": 1,
                        "text": "The Sun shines equally on both land and sea",
                        "hint": "Everything starts with the Sun!",
                        "emoji": "☀️"
                    },
                    {
                        "id": 2,
                        "text": "Land heats up much faster than the sea water",
                        "hint": "Think about hot sand vs cool water!",
                        "emoji": "🏖️"
                    },
                    {
                        "id": 3,
                        "text": "Air above the hot land gets heated and expands",
                        "hint": "This comes AFTER land heats up.",
                        "emoji": "🌡️"
                    },
                    {
                        "id": 4,
                        "text": "The hot, light air above the land rises upward",
                        "hint": "Warm air is lighter — it rises!",
                        "emoji": "⬆️"
                    },
                    {
                        "id": 5,
                        "text": "A low pressure area is created above the land",
                        "hint": "When air rises, it leaves low pressure. Comes AFTER air rises.",
                        "emoji": "🔽"
                    },
                    {
                        "id": 6,
                        "text": "Cool air from the sea rushes towards the land to fill the gap",
                        "hint": "This comes AFTER the low pressure forms!",
                        "emoji": "💨"
                    },
                    {
                        "id": 7,
                        "text": "This movement of cool air from sea to land is the Sea Breeze!",
                        "hint": "The final result — the breeze at the beach!",
                        "emoji": "🌊"
                    }
                ]
            },
            "correctOrder": {
                "type": "array",
                "default": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7
                ]
            },
            "contextLocation": {
                "type": "string",
                "default": "Kerala beach"
            },
            "showAnimation": {
                "type": "boolean",
                "default": true
            },
            "difficulty": {
                "type": "string",
                "enum": [
                    "easy",
                    "medium",
                    "hard"
                ],
                "default": "medium"
            },
            "titleText": {
                "type": "string",
                "default": "Sea Breeze Formation"
            },
            "instructionText": {
                "type": "string",
                "default": "Drag the jumbled steps into the correct order (1→7). Each step CAUSES the next!"
            },
            "completionMessage": {
                "type": "string",
                "default": "You've mastered the sea breeze mechanism!"
            }
        }
    },
    "teaching_notes": {
        "when_to_use": "Activate AFTER the sea breeze mechanism diagram and video. Tests causal chain reconstruction.",
        "common_mistakes": "Students often place 'air rushes from sea' before 'low pressure forms.'",
        "follow_up": "Ask the student to explain sea breeze step by step in their own words.",
        "learning_objectives": [
            "Reconstruct the causal chain of sea breeze formation",
            "Understand differential heating drives convection",
            "Connect convection to real-world weather phenomena"
        ]
    },
    "instructions_for_student": "The 7 steps of sea breeze formation are all JUMBLED UP! Drag them into the correct order from Step 1 to Step 7. Think carefully about cause and effect — each step CAUSES the next one!",
