{
    "toolName": "circuit_symbols_tool",
    "version": "2.0.0",
    "description": "An interactive circuit diagram symbols learning tool for Grade 7 Science (NCERT Chapter 3). The tool has two modes: Learn mode with 7 progressive steps covering introduction, cell symbol (long line = positive, short = negative), battery symbol (multiple cells), lamp symbol (cross in circle), LED symbol (triangle with light arrows, one-direction only), switch ON/OFF symbols, and a complete circuit diagram. Practice mode provides 6 quiz questions testing symbol identification, terminal recognition, and circuit behavior prediction with immediate feedback. Canvas-based rendering with accurate symbol proportions. Indian school educational context. Clean, colorful UI styled with Singularity Design System — Poppins font, #4A4DC9 primary indigo, #FF7212 accent orange, #533086→#FC9145 gradient, pill-shaped contained/outlined buttons.",
    "designSystem": {
        "name": "Singularity",
        "font": "Poppins",
        "colors": {
            "primary": "#4A4DC9",
            "primaryDark": "#533086",
            "accent": "#FF7212",
            "accentWarm": "#FC9145",
            "primaryLight": "#C1C1EA",
            "accentLight": "#FFF3E4",
            "neutralDark": "#4E4E4E",
            "neutralMid": "#CACACA",
            "neutralLight": "#EBEBEB",
            "surface": "#F5F5F5",
            "white": "#FFFFFF"
        },
        "gradients": {
            "primary": "linear-gradient(135deg, #533086 0%, #FC9145 100%)",
            "header": "linear-gradient(135deg, #533086 0%, #4A4DC9 50%, #FC9145 100%)",
            "accent": "linear-gradient(135deg, #FF7212 0%, #FC9145 100%)"
        },
        "buttons": {
            "style": "pill (border-radius: 999px)",
            "variants": [
                "contained",
                "outlined",
                "texted"
            ],
            "states": [
                "enabled",
                "disabled",
                "hover",
                "pressed"
            ],
            "padding": "10px 24px",
