    "decision_tree": {
        "description": "Guide for agents to decide which parameters to use",
        "rules": [
            {
                "condition": "Student starting Chapter 3 for the first time",
                "action": "Use default parameters — full 14-appliance activity"
            },
            {
                "condition": "Student needs a simpler activity",
                "action": "Use focused variant with 2-3 categories only"
            },
            {
                "condition": "Student wants a harder challenge",
                "action": "Use extended variant with 18+ appliances"
            },
            {
                "condition": "Classroom projector or dark environment",
                "action": "Set darkMode: true"
            },
            {
                "condition": "Mobile device detected",
                "action": "Set width: 400, height: 800"
            },
            {
                "condition": "Student completed and wants to redo",
                "action": "Re-render with same parameters — cards auto-shuffle"
            }
        ]
    },
    "additionalProps_reference": {
        "title": {
