                }
              }
            }
          },
          "instructions_for_student": "The battery symbol: The longer line is positive (+) and the shorter line is negative (-)."
        }
      },
      {
        "name": "Dark Mode Learning",
        "description": "Learn mode with dark theme for low-light environments",
        "value": {
          "frontend_action": "show_interactive_tool",
