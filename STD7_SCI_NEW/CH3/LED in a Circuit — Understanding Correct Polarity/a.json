{
  "toolName": "circuit_diagram",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Electric Circuit Learning Tool Schema",
    "description": "Interactive educational tool for teaching electric circuits, circuit symbols, and basic electrical concepts to Grade 7 students",
    "type": "object",
    "required": [
      "frontend_action",
      "title",
      "data"
    ],
    "properties": {
      "frontend_action": {
        "type": "string",
        "const": "show_interactive_tool",
        "description": "Action type for frontend"
      },
      "title": {
        "type": "string",
        "description": "Display title for the tool",
        "examples": [
          "Electric Circuit Symbols",
          "Circuit Practice Questions",
          "Build Your Own Circuit",
          "Circuits in Real Life"
        ]
      },
      "data": {
        "type": "object",
        "required": [
          "toolName",
          "parameters"
        ],
        "properties": {
          "toolName": {
            "type": "string",
            "const": "electric_circuit_tool",
            "description": "Identifier for the electric circuit tool"
          },
          "parameters": {
            "type": "object",
            "description": "Configuration parameters for the tool",
            "properties": {
              "width": {
                "type": "number",
                "default": 800,
                "description": "Width of the component in pixels",
                "minimum": 320,
                "maximum": 1920
              },
              "height": {
                "type": "number",
                "default": 600,
                "description": "Height of the component in pixels",
                "minimum": 240,
                "maximum": 1080
              },
              "initialMode": {
                "type": "string",
                "enum": [
                  "learn",
                  "practice",
                  "real_world",
                  "hands_on"
                ],
                "default": "learn",
                "description": "Starting mode of the tool",
                "examples": [
                  "learn",
                  "practice",
                  "real_world",
                  "hands_on"
                ]
              },
              "showModeSelector": {
                "type": "boolean",
                "default": true,
                "description": "Show or hide the mode selector tabs"
              },
              "enabledModes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "learn",
                    "practice",
                    "real_world",
                    "hands_on"
                  ]
                },
                "default": [
                  "learn",
                  "practice",
                  "real_world",
                  "hands_on"
                ],
                "description": "Which modes should be available to the user",
                "examples": [
                  [
                    "learn",
                    "practice"
                  ],
                  [
                    "real_world",
                    "hands_on"
                  ],
                  [
                    "learn"
                  ]
                ]
              },
              "showNavigation": {
                "type": "boolean",
                "default": true,
                "description": "Show or hide previous/next navigation buttons"
              },
              "showPlayPause": {
                "type": "boolean",
                "default": true,
                "description": "Show or hide play/pause button for auto-progression"
              },
              "showStepIndicator": {
                "type": "boolean",
                "default": true,
                "description": "Show or hide step counter/indicator"
              },
              "autoPlayDuration": {
                "type": "number",
                "default": 8000,
                "description": "Auto-advance delay in milliseconds. Set to 0 to disable auto-play",
                "minimum": 0,
                "examples": [
                  0,
                  3000,
                  5000,
                  8000,
                  10000
                ]
              },
              "themeColor": {
                "type": "string",
                "default": "#14b8a6",
                "description": "Primary theme color in hex format",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "examples": [
                  "#14b8a6",
                  "#3b82f6",
                  "#8b5cf6",
                  "#f59e0b",
                  "#ef4444"
                ]
              },
              "darkMode": {
                "type": "boolean",
                "default": false,
                "description": "Enable dark mode theme"
              },
              "initialStep": {
                "type": "number",
                "default": 0,
                "description": "Starting step index (0-based)",
                "minimum": 0
              },
              "filterSteps": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Array of step IDs to show (filters out others)",
                "examples": [
                  [
                    0,
                    1,
                    2
                  ],
                  [
                    5,
                    10,
                    15
                  ]
                ]
              },
              "animationSpeed": {
                "type": "number",
                "default": 1,
                "description": "Animation speed multiplier (1 = normal speed)",
                "minimum": 0.1,
                "maximum": 3
              },
              "additionalProps": {
                "type": "object",
                "description": "Tool-specific dynamic configuration",
                "properties": {
                  "highlightComponent": {
                    "type": "string",
                    "enum": [
                      "cell",
                      "battery",
                      "lamp",
                      "led",
                      "switch-on",
                      "switch-off",
                      "wire"
                    ],
                    "description": "Component ID to highlight in learn mode",
                    "examples": [
                      "battery",
                      "led",
                      "switch-on"
                    ]
                  },
                  "showCircuitExample": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the complete circuit example in learn mode"
                  },
                  "customLabels": {
                    "type": "object",
                    "description": "Custom labels for circuit polarity",
                    "properties": {
                      "positive": {
                        "type": "string",
                        "default": "+",
                        "description": "Label for positive terminal",
                        "examples": [
                          "+",
                          "Positive",
                          "धनात्मक (+)",
                          "ધન (+)"
                        ]
                      },
                      "negative": {
                        "type": "string",
                        "default": "-",
                        "description": "Label for negative terminal",
                        "examples": [
                          "-",
                          "Negative",
                          "ऋणात्मक (-)",
                          "ઋણ (-)"
                        ]
                      }
                    }
                  },
                  "showHints": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable hint system in practice mode"
                  },
                  "maxAttempts": {
                    "type": "number",
                    "default": 3,
                    "description": "Maximum attempts allowed per practice question",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "questions": {
                    "type": "array",
                    "description": "Custom practice questions (overrides built-in questions)",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "question",
                        "type",
                        "circuits",
                        "correctAnswer",
                        "explanation"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "Unique question identifier"
                        },
                        "question": {
                          "type": "string",
                          "description": "Question text to display"
                        },
                        "type": {
                          "type": "string",
                          "const": "diagram",
                          "description": "Question type (currently only diagram supported)"
                        },
                        "circuits": {
                          "type": "array",
                          "description": "Array of circuit options",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "isCorrect"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Circuit option ID"
                              },
                              "isCorrect": {
                                "type": "boolean",
                                "description": "Whether this is the correct answer"
                              }
                            }
                          }
                        },
                        "correctAnswer": {
                          "type": "string",
                          "description": "ID of the correct circuit"
                        },
                        "explanation": {
                          "type": "string",
                          "description": "Explanation shown after answer submission"
                        },
                        "hint": {
                          "type": "string",
                          "description": "Optional hint text"
                        }
                      }
                    }
                  },
                  "components": {
                    "type": "array",
                    "description": "Custom circuit components configuration",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "cell",
                            "battery",
                            "lamp",
                            "led",
                            "switch",
                            "wire",
                            "conductor",
                            "insulator"
                          ]
                        },
                        "position": {
                          "type": "object",
                          "properties": {
                            "x": {
                              "type": "number"
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        },
                        "connections": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "on",
                            "off",
                            "open",
                            "closed"
                          ]
                        },
                        "polarity": {
                          "type": "string",
                          "enum": [
                            "correct",
                            "incorrect",
                            "neutral"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "instructions_for_student": {
        "type": "string",
        "description": "Instructions or context for the student",
        "examples": [
          "Learn about circuit symbols and how to draw circuit diagrams!",
          "Test your knowledge with these practice questions.",
          "Follow these steps to build your own simple circuit safely.",
          "Explore where electric circuits are used in everyday life."
        ]
      }
    },
    "examples": [
      {
        "name": "Basic Learn Mode",
        "description": "Default learning mode showing all circuit symbols",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Electric Circuit Symbols",
          "data": {
            "toolName": "electric_circuit_tool",
            "parameters": {
              "initialMode": "learn",
              "showModeSelector": true
            }
          },
          "instructions_for_student": "Let's learn about the standard symbols used in electric circuit diagrams!"
        }
      },
      {
        "name": "Practice Mode with Hints",
        "description": "Practice questions with hints enabled",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Practice: Circuit Diagrams",
          "data": {
            "toolName": "electric_circuit_tool",
            "parameters": {
              "initialMode": "practice",
              "showModeSelector": false,
              "additionalProps": {
                "showHints": true,
                "maxAttempts": 3
              }
            }
          },
          "instructions_for_student": "Test your understanding! Select the correct circuit diagram for each question."
        }
      },
      {
        "name": "Assessment Mode (No Hints)",
        "description": "Assessment with single attempt and no hints",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Circuit Assessment",
          "data": {
            "toolName": "electric_circuit_tool",
            "parameters": {
              "initialMode": "practice",
              "showModeSelector": false,
              "showNavigation": false,
              "additionalProps": {
                "showHints": false,
                "maxAttempts": 1
              }
            }
          },
          "instructions_for_student": "Assessment: Choose the correct answer for each question. No hints available!"
        }
      },
      {
        "name": "Real World Applications",
        "description": "Explore real-world uses of electric circuits",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Circuits in Daily Life",
          "data": {
            "toolName": "electric_circuit_tool",
            "parameters": {
              "initialMode": "real_world",
              "showModeSelector": true,
              "enabledModes": [
                "real_world",
                "learn"
              ]
            }
          },
          "instructions_for_student": "See how electric circuits power devices and systems you use every day!"
        }
      },
      {
        "name": "Hands-On Experiments",
        "description": "Safe DIY circuit building guide",
        "value": {
          "frontend_action": "show_interactive_tool",
          "title": "Build Your Own Circuit",
          "data": {
            "toolName": "electric_circuit_tool",
            "parameters": {
              "initialMode": "hands_on",
              "showModeSelector": false,
              "themeColor": "#3b82f6"
            }
          },
          "instructions_for_student": "Follow these safe steps to build simple circuits at home! Ask an adult for help."
        }
      },
      {
        "name": "Focus on Battery Symbol",
        "description": "Highlight specific component in learn mode",
        "value": {
          "frontend_action": "show_interactive_tool",
