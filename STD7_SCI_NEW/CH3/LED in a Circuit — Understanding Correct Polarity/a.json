    ],
    "metadata": {
      "tool_version": "1.0.0",
      "curriculum_alignment": "NCERT Grade 7 Science - Electric Current and Its Effects",
      "educational_level": "Grade 7 (Ages 11-13)",
      "subject": "Science - Physics",
      "topics": [
        "Electric Circuits",
        "Circuit Symbols",
        "Circuit Diagrams",
        "Electrical Components",
        "Conductors",
        "Power Sources",
        "Switches",
        "LEDs and Polarity"
      ],
      "learning_outcomes": [
        "Identify standard electric circuit symbols",
        "Draw simple circuit diagrams",
        "Understand complete vs incomplete circuits",
        "Recognize correct LED polarity",
        "Explain function of switches",
        "Apply circuit knowledge to real-world devices",
        "Build safe, simple circuits"
      ],
      "supported_languages": [
        "English",
        "Hindi (via customLabels)",
        "Gujarati (via customLabels)"
      ],
      "accessibility_features": [
        "Keyboard navigation",
        "ARIA labels",
        "Dark mode support",
        "High contrast options",
        "Text descriptions",
        "Responsive design"
      ]
    }
  },
