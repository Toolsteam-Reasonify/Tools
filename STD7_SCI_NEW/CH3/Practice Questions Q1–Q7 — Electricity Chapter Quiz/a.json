                    "text": "#CACACA"
                }
            },
            "highlight": {
                "enabled": {
                    "bg": "#FF7212",
                    "text": "#FFFFFF"
                },
                "hover": {
                    "bg": "#4A4DC9",
                    "text": "#FFFFFF"
                },
                "pressed": {
                    "bg": "#E5660F",
                    "text": "#FFFFFF"
                }
            },
            "outlined": {
                "enabled": {
                    "bg": "transparent",
                    "text": "#4A4DC9",
                    "border": "#4A4DC9"
                },
                "hover": {
                    "bg": "#EAEAFF",
                    "text": "#FF7212",
                    "border": "#FF7212"
                },
                "pressed": {
                    "bg": "#EAEAFF",
                    "text": "#4A4DC9"
                }
            }
        }
    },
    "parameters": {
