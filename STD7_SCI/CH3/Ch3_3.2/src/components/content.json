      {
        "id": "p1",
        "question": "Which circuit diagram shows a complete, working circuit?",
        "type": "diagram",
        "correct_answer": "p1a",
        "explanation": "A complete circuit must form a closed loop from the positive terminal of the cell, through components, and back to the negative terminal.",
        "hint": "Look for a circuit that forms a complete loop without any breaks."
      },
      {
        "id": "p2",
        "question": "In which circuit is the LED connected with correct polarity?",
        "type": "diagram",
        "correct_answer": "p2a",
        "explanation": "LEDs have polarity. The positive terminal (anode) should connect to the positive terminal of the battery, and the negative terminal (cathode) to the negative terminal.",
        "hint": "Remember: LED anode (long leg) connects to positive, cathode (short leg) connects to negative."
      },
      {
        "id": "p3",
        "question": "Why won't the lamp light up in this circuit?",
        "type": "diagram",
        "correct_answer": "p3a",
        "explanation": "The switch is open, which breaks the circuit. No current can flow when the switch is open, so the lamp won't light.",
        "hint": "Check the position of the switch - is it allowing current to flow?"
      },
      {
        "id": "p4",
        "question": "Which terminal of the cell is positive?",
        "type": "diagram",
        "correct_answer": "p4a",
        "explanation": "In a cell symbol, the longer line represents the positive terminal, and the shorter line represents the negative terminal.",
        "hint": "Look at the lengths of the lines in the cell symbol."
      },
      {
        "id": "p5",
        "question": "In which direction does current flow from the battery?",
        "type": "diagram",
        "correct_answer": "p5a",
        "explanation": "Current flows from the positive terminal of the battery, through the circuit components, and back to the negative terminal.",
