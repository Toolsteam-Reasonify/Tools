{
  "tool_name": "water_cycle_learning",
  "title": "Water Cycle Interactive Learning Tool",
  "description": "Interactive educational tool for Grade 7 students to learn about the water cycle through visual animations, practice questions, and real-world examples",
  "component_file": "WaterCycleLearning.jsx",
  "parameters": {
    "width": {
      "type": "number",
      "default": 800,
      "description": "Width of the component canvas in pixels"
    },
    "height": {
      "type": "number",
      "default": 600,
      "description": "Height of the component canvas in pixels"
    },
    "data": {
      "type": "object",
      "description": "Base configuration for the water cycle tool",
      "properties": {
        "themeColor": {
          "type": "string",
          "default": "#3B82F6",
          "description": "Primary theme color (blue shades recommended)"
        },
        "autoPlayDuration": {
          "type": "number",
          "default": 8000,
          "description": "Duration in milliseconds for auto-advance in Learn mode"
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "Array of learning steps across all three modes (Learn, Practice, Real World)",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "type", "mode"],
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique identifier for the step"
          },
          "title": {
            "type": "string",
            "description": "Title of the step"
          },
          "description": {
            "type": "string",
            "description": "Detailed description explaining the concept"
          },
          "type": {
            "type": "string",
            "enum": ["intro", "explanation", "practice", "real_world"],
            "description": "Type of step content"
          },
          "mode": {
            "type": "string",
            "enum": ["learn", "practice", "real_world"],
            "description": "Which mode this step belongs to"
          },
          "data": {
            "type": "object",
            "description": "Step-specific data for visualization or interaction",
            "properties": {
              "stage": {
                "type": "string",
                "description": "Current stage of water cycle (for Learn mode)"
              },
              "activeElements": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Elements to highlight in visualization"
              },
              "question": {
                "type": "string",
                "description": "Question text (for Practice mode)"
              },
              "answer": {
                "type": ["string", "array"],
                "description": "Correct answer(s) for practice questions"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Multiple choice options (for Practice mode)"
              },
              "example": {
                "type": "string",
                "description": "Real-world example identifier (for Real World mode)"
              },
              "relatedStage": {
                "type": "string",
                "description": "Related water cycle stage for real-world example"
              }
            }
          }
        }
      }
    }
  }
}


