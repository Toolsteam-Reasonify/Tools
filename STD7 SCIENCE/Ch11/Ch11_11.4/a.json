{
  "toolName": "shadow_formation",
  "parameters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Shadow Formation Interactive Tool",
    "description": "A comprehensive educational tool for learning about shadows, light, and optical properties (English only)",
    "type": "object",
    "properties": {
      "toolName": {
        "type": "string",
        "const": "shadow_formation_tool",
        "description": "Unique identifier for the shadow formation tool"
      },
      "parameters": {
        "type": "object",
        "description": "Configuration parameters for the shadow formation tool",
        "properties": {
          "width": {
            "type": "number",
            "default": 800,
            "description": "Width of the tool canvas in pixels",
            "minimum": 400,
            "maximum": 1920
          },
          "height": {
            "type": "number",
            "default": 600,
            "description": "Height of the tool canvas in pixels",
            "minimum": 300,
            "maximum": 1080
          },
          "initialMode": {
            "type": "string",
            "enum": [
              "learn",
              "practice",
              "real_world"
            ],
            "default": "learn",
            "description": "Starting mode/tab for the tool"
          },
          "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Whether to show the mode selection tabs"
          },
          "enabledModes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "learn",
                "practice",
                "real_world"
              ]
            },
            "default": [
              "learn",
              "practice",
              "real_world"
            ],
            "description": "Which modes are available to the user"
          },
          "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide navigation buttons"
          },
          "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide play/pause controls"
          },
          "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide step counter indicator"
          },
          "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier (1 = normal speed)",
            "minimum": 0.5,
            "maximum": 3
          },
          "autoPlayDuration": {
            "type": "number",
            "default": 8000,
            "description": "Auto-advance delay in milliseconds (0 = disabled)",
            "minimum": 0
          },
          "themeColor": {
            "type": "string",
            "default": "#3b82f6",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Primary theme color in hex format"
          },
          "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode theme"
          },
          "additionalProps": {
            "type": "object",
            "description": "Shadow-specific customization options",
            "properties": {
              "initialObject": {
                "type": "string",
                "enum": [
                  "cat",
                  "superhero",
                  "bottle",
                  "glass",
                  "paper",
                  "football",
                  "tree"
                ],
                "description": "Pre-selected object in the simulator"
              },
              "lightSize": {
                "type": "string",
                "enum": [
                  "small",
                  "large"
                ],
                "default": "small",
                "description": "Initial light source size (small = sharp shadows, large = soft shadows)"
              },
              "showRays": {
                "type": "boolean",
                "default": false,
                "description": "Show light rays in the simulator by default"
              },
              "practiceScenarios": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Specific practice scenario IDs to display (filters the scenarios)"
              },
              "randomizeScenarios": {
                "type": "boolean",
                "default": false,
                "description": "Randomize the order of practice scenarios"
              },
              "filterApplications": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Filter real-world applications by category (e.g., ['Art', 'Astronomy'])"
              },
              "highlightMaterialType": {
                "type": "string",
                "enum": [
                  "transparent",
                  "translucent",
                  "opaque",
                  "mixed"
                ],
                "description": "Highlight applications with specific material type"
              },
              "customTheme": {
                "type": "object",
                "description": "Custom theme colors",
                "properties": {
                  "primaryColor": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "description": "Primary theme color"
                  },
                  "secondaryColor": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "description": "Secondary theme color"
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "toolName",
      "parameters"
    ],
    "examples": [
      {
        "toolName": "shadow_formation_tool",
        "description": "Basic shadow learning experience",
        "parameters": {
          "initialMode": "learn",
          "showModeSelector": true
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Practice only mode",
        "parameters": {
          "initialMode": "practice",
          "showModeSelector": false,
          "enabledModes": [
            "practice"
          ]
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Simulator with pre-selected object and light rays",
        "parameters": {
          "initialMode": "learn",
          "additionalProps": {
            "initialObject": "cat",
            "lightSize": "large",
            "showRays": true
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Real-world applications focus",
        "parameters": {
          "initialMode": "real_world",
          "additionalProps": {
            "filterApplications": [
              "Astronomy",
              "Time Telling"
            ]
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Focused practice on specific scenarios",
        "parameters": {
          "initialMode": "practice",
          "showModeSelector": false,
          "additionalProps": {
            "practiceScenarios": [
              0,
              2,
              4
            ],
            "randomizeScenarios": true
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Custom themed experience with auto-play",
        "parameters": {
          "themeColor": "#8b5cf6",
          "autoPlayDuration": 5000,
          "additionalProps": {
            "customTheme": {
              "primaryColor": "#8b5cf6",
              "secondaryColor": "#ec4899"
            }
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Real-world applications filtered by material type",
        "parameters": {
          "initialMode": "real_world",
          "showModeSelector": false,
          "additionalProps": {
            "highlightMaterialType": "opaque",
            "filterApplications": [
              "Art",
              "Design"
            ]
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Minimal UI for demonstration",
        "parameters": {
          "showModeSelector": false,
          "showNavigation": false,
          "showPlayPause": false,
          "showStepIndicator": false,
          "initialMode": "learn"
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Translucent object demonstration",
        "parameters": {
          "initialMode": "learn",
          "enabledModes": [
            "learn"
          ],
          "additionalProps": {
            "initialObject": "bottle",
            "lightSize": "large",
            "showRays": true
          }
        }
      },
      {
        "toolName": "shadow_formation_tool",
        "description": "Full-featured learning experience",
        "parameters": {
          "width": 1200,
          "height": 800,
          "showModeSelector": true,
          "enabledModes": [
            "learn",
            "practice",
            "real_world"
          ],
          "animationSpeed": 1.2,
          "themeColor": "#14b8a6",
          "additionalProps": {
            "lightSize": "large",
            "showRays": false
          }
        }
      }
    ],
    "additionalProps": {
      "examples": [
        {
          "name": "Cat simulator with light rays",
          "value": {
            "initialObject": "cat",
            "lightSize": "small",
            "showRays": true
          }
        },
        {
          "name": "Practice mode with specific scenarios",
          "value": {
            "practiceScenarios": [
              0,
              1,
              2,
              3
            ],
            "randomizeScenarios": false
          }
        },
        {
          "name": "Astronomy and time applications",
          "value": {
            "filterApplications": [
              "Astronomy",
              "Time Telling"
            ],
            "highlightMaterialType": "opaque"
          }
        },
        {
          "name": "Custom purple theme",
          "value": {
            "customTheme": {
              "primaryColor": "#9333ea",
              "secondaryColor": "#ec4899"
            }
          }
        },
        {
          "name": "Bottle simulator (translucent demo)",
          "value": {
            "initialObject": "bottle",
            "lightSize": "large",
            "showRays": true
          }
        }
      ]
    }
  },
  "usage_example": {}
}