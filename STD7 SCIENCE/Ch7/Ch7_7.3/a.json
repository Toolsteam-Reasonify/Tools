{
    "toolName": "radiation_tool",
    "version": "1.0.0",
    "description": "Interactive educational tool teaching Grade 7 students about Radiation — the process of heat transfer that requires no medium. Covers Sun's heat reaching Earth, heat from fire, light vs dark clothing, and real-world examples like solar heaters and thermos flasks. Based on NCERT Chapter 7.3.",
    "category": "science",
    "grade": "7",
    "subject": "Science",
    "chapter": "7 - Heat Transfer in Nature",
    "section": "7.3 - Radiation",
    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Width of the tool container in pixels"
        },
        "height": {
            "type": "number",
            "default": 600,
            "description": "Height of the tool container in pixels"
        },
        "initialMode": {
            "type": "string",
            "enum": ["learn", "practice", "real_world", "hands_on"],
            "default": "learn",
            "description": "Starting mode for the tool"
        },
        "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Show or hide the mode tab selector"
        },
        "enabledModes": {
            "type": "array",
            "items": { "type": "string", "enum": ["learn", "practice", "real_world", "hands_on"] },
            "default": ["learn", "practice", "real_world", "hands_on"],
            "description": "Which modes to enable"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show prev/next navigation buttons"
        },
        "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show auto-play button (learn mode only)"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show step counter (Step X of Y)"
        },
        "initialStep": {
            "type": "number",
            "description": "Starting step ID"
        },
        "filterSteps": {
            "type": "array",
            "items": { "type": "number" },
            "description": "Only show steps with these IDs"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier"
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 8000,
            "description": "Auto-advance delay in milliseconds"
        },
        "themeColor": {
            "type": "string",
            "default": "#4A4DC9",
            "description": "Primary accent color"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode"
        }
    },
    "additionalProps": {
        "description": "Tool-specific dynamic content that an agent can pass to customize the radiation demo.",
        "schema": {
            "showSunDemo": {
                "type": "boolean",
                "default": true,
                "description": "Whether to show the Sun-Earth radiation demo"
            },
            "showFireDemo": {
                "type": "boolean",
                "default": true,
                "description": "Whether to show the fireplace radiation demo"
            },
            "showClothingDemo": {
                "type": "boolean",
                "default": true,
                "description": "Whether to show the light vs dark clothing demo"
            },
            "heatSourceType": {
                "type": "string",
                "enum": ["sun", "fire", "heater", "all"],
                "default": "all",
                "description": "Which heat source to focus on"
            },
            "showWaveAnimation": {
                "type": "boolean",
                "default": true,
                "description": "Animate heat radiation waves"
            },
            "radiationIntensity": {
                "type": "number",
                "min": 1,
                "max": 10,
                "default": 5,
                "description": "Intensity of radiation visualization"
            },
            "showMediumComparison": {
                "type": "boolean",
                "default": true,
                "description": "Show conduction vs convection vs radiation comparison"
            },
            "customScenarios": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "source": { "type": "string" },
                        "receiver": { "type": "string" },
                        "medium": { "type": "string" },
                        "description": { "type": "string" }
                    }
                },
                "description": "Custom real-world radiation scenarios"
            }
        },
        "examples": {
            "default": {},
            "sun_focus": {
                "heatSourceType": "sun",
                "showWaveAnimation": true,
                "radiationIntensity": 8
            },
            "clothing_focus": {
                "showClothingDemo": true,
                "showSunDemo": false,
                "showFireDemo": false
            },
            "custom_scenario": {
                "customScenarios": [
                    {
                        "name": "Room Heater",
                        "source": "Electric heater",
                        "receiver": "Person sitting nearby",
                        "medium": "Air (but radiation doesn't need it!)",
                        "description": "An electric room heater warms you through infrared radiation."
                    }
                ]
            }
        }
    },
    "modes": {
        "learn": {
            "label": "Learn",
            "description": "Step-by-step explanation of radiation with animated visuals",
            "stepIds": [1, 2, 3, 4, 5, 6]
        },
        "practice": {
            "label": "Practice",
            "description": "Multiple-choice quiz questions with instant feedback",
            "stepIds": [10, 11, 12, 13]
        },
        "real_world": {
            "label": "Real World",
            "description": "Real-life examples: campfire, solar heater, thermos flask",
            "stepIds": [20, 21, 22]
        },
        "hands_on": {
            "label": "Hands On",
            "description": "Interactive slider experiments: colour absorption and distance vs heat",
            "stepIds": [30, 31]
        }
    },
    "steps": {
        "learn": [
            { "id": 1, "title": "What is Radiation?" },
            { "id": 2, "title": "Heat from the Sun" },
            { "id": 3, "title": "Warmth from a Fire" },
            { "id": 4, "title": "All Objects Radiate Heat" },
            { "id": 5, "title": "No Medium Needed!" },
            { "id": 6, "title": "Light vs Dark Colours" }
        ],
        "practice": [
            { "id": 10, "title": "How does Sun's heat reach Earth?" },
            { "id": 11, "title": "Which transfer needs no medium?" },
            { "id": 12, "title": "Why light clothes in summer?" },
            { "id": 13, "title": "Why does a hot utensil cool?" }
        ],
        "real_world": [
            { "id": 20, "title": "Campfire" },
            { "id": 21, "title": "Solar Water Heater" },
            { "id": 22, "title": "Thermos Flask" }
        ],
        "hands_on": [
            { "id": 30, "title": "Colour & Heat Absorption" },
            { "id": 31, "title": "Distance & Heat" }
        ]
    }
}