                            }
                        }
                    }
                },
                "instructions_for_student": "विद्युत परिपथ के मानक प्रतीकों के बारे में सीखें!"
            }
        },
        {
            "name": "Quick Practice — 5 Minutes",
            "description": "Fast-paced practice session",
            "value": {
                "frontend_action": "show_interactive_tool",
                "title": "Quick Practice",
                "data": {
                    "toolName": "electric_circuit_tool",
                    "parameters": {
                        "initialMode": "practice",
                        "showModeSelector": false,
