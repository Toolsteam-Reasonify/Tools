                        }
                    }
                },
                "instructions_for_student": "Quick 5-minute practice session! Test your circuit knowledge."
            }
        },
        {
            "name": "Safety-First Hands-On",
            "description": "Emphasize safety in DIY experiments",
            "value": {
                "frontend_action": "show_interactive_tool",
                "title": "Safe Circuit Building",
                "data": {
                    "toolName": "electric_circuit_tool",
                    "parameters": {
                        "initialMode": "hands_on",
                        "showModeSelector": false
                    }
                },
                "instructions_for_student": "⚠️ IMPORTANT: Only use batteries, never mains electricity. Ask an adult to supervise!"
            }
        }
    ],
    "metadata": {
        "tool_version": "2.0.0",
        "design_system": "Singularity Design System",
        "design_tokens": {
            "colors": {
                "primary": "#4A4DC9",
                "accent": "#FF7212",
                "gradientStart": "#533086",
                "gradientEnd": "#FC9145",
                "lightPurple": "#C1C1EA",
                "lightOrange": "#FFF3E4",
                "dark": "#4E4E4E",
                "gray": "#CACACA",
                "lightGray": "#EBEBEB",
                "offWhite": "#F5F5F5",
                "success": "#22C55E",
                "error": "#EF4444"
            },
            "font": "Poppins (300–800)",
            "borderRadius": {
                "sm": "8px",
                "md": "12px",
                "lg": "20px",
                "pill": "999px"
            },
            "buttonVariants": [
                "contained",
                "outlined",
                "text",
                "gradient"
            ]
        },
        "curriculum_alignment": "NCERT Grade 7 Science — Electric Current and Its Effects",
        "educational_level": "Grade 7 (Ages 11–13)",
        "subject": "Science — Physics",
        "topics": [
            "Electric Circuits",
            "Circuit Symbols",
            "Circuit Diagrams",
            "Electrical Components",
            "Conductors",
            "Power Sources",
            "Switches",
            "LEDs and Polarity"
        ],
        "learning_outcomes": [
            "Identify standard electric circuit symbols",
            "Draw simple circuit diagrams",
            "Understand complete vs incomplete circuits",
            "Recognize correct LED polarity",
            "Explain function of switches",
            "Apply circuit knowledge to real-world devices",
            "Build safe, simple circuits"
        ],
        "supported_languages": [
            "English",
            "Hindi (via customLabels)",
            "Gujarati (via customLabels)"
        ],
        "responsive_breakpoints": {
            "mobile": "<640px (single-column grid, smaller fonts/padding)",
            "desktop": "≥640px (multi-column auto-fill grid)"
        },
        "accessibility_features": [
            "Keyboard navigation (tab/enter on cards)",
            "ARIA labels on SVG symbols",
            "Poppins font with clear weight hierarchy",
            "High-contrast color pairings",
            "Focus-visible states on interactive elements",
            "Responsive fluid layout (no fixed pixel widths)"
        ],
        "removed_from_v1": {
            "description": "Properties removed in the v2 redesign for simplification and responsive-first approach",
            "properties": [
                "width (now responsive, auto-fills container)",
                "height (now min-height: 100vh, content-driven)",
                "darkMode (Singularity DS is light-theme only)",
                "themeColor (fixed to DS primary #4A4DC9 / accent #FF7212)",
                "showNavigation (navigation is mode-contextual)",
                "showPlayPause (auto-play removed for better UX)",
                "showStepIndicator (replaced by question counter in practice)",
                "initialStep (steps system removed; modes are top-level)",
                "filterSteps (steps system removed)",
                "animationSpeed (fixed CSS animation timings)",
                "autoPlayDuration (auto-play removed)"
            ]
        }
    }
}