{
    "toolName": "pattern_machine_explorer",
    "version": "1.0.0",
    "description": "Interactive pattern discovery tool for teaching integer operations, rule-finding, and algebraic thinking through a step-by-step 'mystery machine' metaphor",

    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Component width in pixels"
        },
        "height": {
            "type": "number",
            "default": 700,
            "description": "Component height in pixels"
        },
        "initialStep": {
            "type": "number",
            "default": 1,
            "min": 1,
            "max": 6,
            "description": "Starting step ID (1-6)"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier (higher = faster)"
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 0,
            "description": "Auto-advance delay in ms (0 = disabled)"
        },
        "themeColor": {
            "type": "string",
            "default": "#4A4DC9",
            "description": "Primary theme color (Singularity indigo)"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable dark mode"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide Previous and Next buttons"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide the 6-step progress indicator"
        }
    },

    "additionalProps": {
        "description": "Tool-specific dynamic content passed by the agent to customize machine data, rules, and labels",
        "schema": {
            "machine1Rows": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "a": { "type": "number", "description": "First input value" },
                        "b": { "type": "number", "description": "Second input value" },
                        "c": { "type": "number", "description": "Third input value" },
                        "output": { "type": ["number", "null"], "description": "Output value (null for prediction row)" }
                    },
                    "required": ["a", "b", "c", "output"]
                },
                "default": [
                    { "a": 5, "b": 8, "c": 3, "output": 10 },
                    { "a": 10, "b": 11, "c": 12, "output": 9 },
                    { "a": 5, "b": 8, "c": -3, "output": 16 },
                    { "a": -3, "b": 10, "c": 2, "output": 5 },
                    { "a": -4, "b": -1, "c": -6, "output": 1 },
                    { "a": -10, "b": -12, "c": -9, "output": null }
                ],
                "description": "Array of 6 rows for Machine 1. The last row should have output: null for student prediction."
            },
            "machine2Rows": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "a": { "type": "number" },
                        "b": { "type": "number" },
                        "c": { "type": "number" },
                        "output": { "type": ["number", "null"] }
                    },
                    "required": ["a", "b", "c", "output"]
                },
                "default": [
                    { "a": 4, "b": 8, "c": -3, "output": -29 },
                    { "a": 6, "b": -11, "c": 12, "output": 54 },
                    { "a": 5, "b": 3, "c": 7, "output": -22 },
                    { "a": -3, "b": 9, "c": -8, "output": 35 },
                    { "a": -7, "b": 4, "c": 6, "output": -17 },
                    { "a": -10, "b": -12, "c": -9, "output": null }
                ],
                "description": "Array of rows for Machine 2 preview (shown at step 6). First 3 rows are displayed."
            },
            "ruleFormula": {
                "type": "string",
                "default": "a + b − c",
                "description": "The rule formula string displayed on the Rule Discovered card"
            },
            "machine2RuleFormula": {
                "type": "string",
                "default": null,
                "description": "Optional rule formula for Machine 2 (not revealed by default)"
            },
            "machineName": {
                "type": "string",
                "default": "Machine 1",
                "description": "Display name for the primary machine"
            },
            "machine2Name": {
                "type": "string",
                "default": "Machine 2",
                "description": "Display name for the secondary machine"
            }
        },
        "examples": {
            "default_addition_subtraction": {
                "machine1Rows": [
                    { "a": 5, "b": 8, "c": 3, "output": 10 },
                    { "a": 10, "b": 11, "c": 12, "output": 9 },
                    { "a": 5, "b": 8, "c": -3, "output": 16 },
                    { "a": -3, "b": 10, "c": 2, "output": 5 },
                    { "a": -4, "b": -1, "c": -6, "output": 1 },
                    { "a": -10, "b": -12, "c": -9, "output": null }
                ],
                "ruleFormula": "a + b − c"
            },
            "multiplication_rule": {
                "machine1Rows": [
                    { "a": 2, "b": 3, "c": 5, "output": 30 },
                    { "a": 4, "b": 1, "c": 2, "output": 8 },
                    { "a": 5, "b": 2, "c": 3, "output": 30 },
                    { "a": -1, "b": 6, "c": 2, "output": -12 },
                    { "a": 3, "b": 3, "c": 3, "output": 27 },
                    { "a": -2, "b": 4, "c": -3, "output": null }
                ],
                "ruleFormula": "a × b × c"
            },
            "sum_of_squares": {
                "machine1Rows": [
                    { "a": 1, "b": 2, "c": 3, "output": 14 },
                    { "a": 2, "b": 3, "c": 4, "output": 29 },
                    { "a": 0, "b": 1, "c": 5, "output": 26 },
                    { "a": -1, "b": 3, "c": 2, "output": 14 },
                    { "a": 4, "b": 0, "c": 1, "output": 17 },
                    { "a": 3, "b": -2, "c": 1, "output": null }
                ],
                "ruleFormula": "a² + b² + c²"
            },
            "weighted_sum": {
                "machine1Rows": [
                    { "a": 1, "b": 2, "c": 3, "output": 14 },
                    { "a": 3, "b": 1, "c": 0, "output": 5 },
                    { "a": 0, "b": 0, "c": 4, "output": 12 },
                    { "a": 2, "b": 3, "c": 1, "output": 11 },
                    { "a": -1, "b": 4, "c": 2, "output": 13 },
                    { "a": 5, "b": -1, "c": 2, "output": null }
                ],
                "ruleFormula": "a + 2b + 3c"
            },
            "simple_addition": {
                "machine1Rows": [
                    { "a": 2, "b": 3, "c": 4, "output": 9 },
                    { "a": 1, "b": 1, "c": 1, "output": 3 },
                    { "a": 5, "b": 0, "c": 5, "output": 10 },
                    { "a": 10, "b": 10, "c": 10, "output": 30 },
                    { "a": -2, "b": 5, "c": 3, "output": 6 },
                    { "a": 7, "b": 8, "c": -5, "output": null }
                ],
                "ruleFormula": "a + b + c"
            },
            "double_first_plus_rest": {
                "machine1Rows": [
                    { "a": 3, "b": 1, "c": 2, "output": 9 },
                    { "a": 5, "b": 2, "c": 1, "output": 13 },
                    { "a": 1, "b": 4, "c": 3, "output": 9 },
                    { "a": -2, "b": 5, "c": 1, "output": 2 },
                    { "a": 4, "b": 0, "c": 0, "output": 8 },
                    { "a": 6, "b": 3, "c": -1, "output": null }
                ],
                "ruleFormula": "2a + b + c"
            }
        }
    },

    "steps": {
        "description": "The tool has 6 fixed progressive steps that reveal data row-by-row",
        "stepSummary": {
            "1": {
                "title": "Row 1 — First Clue",
                "description": "Shows first data row. Student begins forming hypotheses.",
                "rowsToShow": 1,
                "features": ["data_table", "machine_graphic"]
            },
            "2": {
                "title": "Row 2 — Testing Ideas",
                "description": "Second row appears. Hypothesis input becomes available.",
                "rowsToShow": 2,
                "features": ["data_table", "machine_graphic", "hypothesis_input"]
            },
            "3": {
                "title": "Row 3 — Negative Input!",
                "description": "Introduces negative numbers. Tests additive inverse understanding.",
                "rowsToShow": 3,
                "features": ["data_table", "machine_graphic", "hypothesis_input"]
            },
            "4": {
                "title": "Row 4 — Mixed Signs",
                "description": "Mixed positive/negative inputs. Rule must work for all.",
                "rowsToShow": 4,
                "features": ["data_table", "machine_graphic", "hypothesis_input"]
            },
            "5": {
                "title": "Row 5 — Rule Confirmed!",
                "description": "All 5 rows confirm the rule. Rule card is revealed.",
                "rowsToShow": 5,
                "features": ["data_table", "machine_graphic", "rule_card"]
            },
            "6": {
                "title": "Your Turn — Predict!",
                "description": "Student predicts output for row 6. Machine 2 preview appears.",
                "rowsToShow": 6,
                "features": ["data_table", "machine_graphic", "rule_card", "prediction_input", "machine2_preview"]
            }
        }
    }
}