        "enabledModes": { "type": "array", "default": ["learn", "practice", "explore", "real_world"] },
        "showNavigation": { "type": "boolean", "default": true },
        "showStepIndicator": { "type": "boolean", "default": true },
        "initialStep": { "type": "number", "default": 1 },
        "filterSteps": { "type": "array", "default": null },
        "animationSpeed": { "type": "number", "default": 1 },
        "autoPlayDuration": { "type": "number", "default": 0 },
        "themeColor": { "type": "string", "default": "#4A4DC9" },
        "darkMode": { "type": "boolean", "default": false }
    },

    "additionalProps": {
        "properties": {
            "initialAngle": { "type": "number", "default": 60 },
            "minAngle": { "type": "number", "default": 10 },
            "maxAngle": { "type": "number", "default": 170 },
            "showProtractor": { "type": "boolean", "default": true },
            "showGrid": { "type": "boolean", "default": true },
            "showLabels": { "type": "boolean", "default": true },
            "highlightCorresponding": { "type": "boolean", "default": true },
