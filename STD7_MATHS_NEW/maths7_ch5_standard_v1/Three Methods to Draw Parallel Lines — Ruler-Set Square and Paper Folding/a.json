        }
    ],

    "decision_tree": {
        "student_asks_how_to_draw_parallel_lines": {
            "action": "Show Learn mode with ruler sub-tab",
            "parameters": { "initialMode": "learn", "initialSubMethod": "ruler" }
        },
        "student_asks_about_paper_folding": {
            "action": "Show Learn mode with paper sub-tab",
            "parameters": { "initialMode": "learn", "initialSubMethod": "paper" }
        },
        "student_wants_to_practice": {
            "action": "Show Practice mode",
            "parameters": { "initialMode": "practice" }
        },
        "teacher_wants_quiz_only": {
