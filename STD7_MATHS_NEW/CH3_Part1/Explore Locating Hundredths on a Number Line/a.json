            }
        }
    ],

    "decision_tree": {
        "description": "Decision tree for agents choosing tool parameters",
        "rules": [
            {
                "trigger": "Student asks 'What are hundredths on a number line?'",
                "action": "Use initialMode: 'learn', showModeSelector: true"
            },
            {
                "trigger": "Teacher wants to show just 50/100 = 1/2",
                "action": "Use filterSteps: [2], showModeSelector: false"
            },
            {
                "trigger": "Student needs practice placing hundredths",
                "action": "Use initialMode: 'practice'"
            },
            {
                "trigger": "Student asks about values greater than 1",
                "action": "Use filterSteps: [4]"
            },
            {
                "trigger": "Student wants to interact hands-on",
                "action": "Use initialMode: 'hands_on'"
            },
            {
                "trigger": "Teacher wants static reference display",
                "action": "Use filterSteps: [4], autoPlayDuration: 0, showPlayPause: false"
            },
            {
                "trigger": "Student asks about paise and rupees connection",
                "action": "Use initialMode: 'real_world', filterSteps: [21]"
            }
        ]
    }
}