        "learnSteps": [
            { "id": 1, "title": "What is a Balance Scale?", "desc": "A balance scale has two pans hung by chains. When both sides have equal weight, the beam stays perfectly level — this is the basis of equations!" },
            { "id": 2, "title": "The Golden Rule", "desc": "Remove the same weight from BOTH sides → the scale stays balanced. This is how we isolate and find unknowns!" },
