{
    "toolName": "balance_scale_tool",
    "version": "3.0.0",
    "description": "Interactive brass balance scale tool for finding unknown weights. Items sit ON pans (not floating). Performance-optimized with memoized SVG. Singularity Design System (Poppins, #4A4DC9/#FF7212). Two modes: Learn (6 steps with equations merged) and Practice (5 MCQ questions, one at a time).",
    "designSystem": "Singularity",
    "scaleStyle": "Realistic brass balance scale with ornate finial, cylindrical pillar, chain-hung circular pans, items placed ON pan surface",
    "category": "algebra",
    "gradeLevel": "7",
    "subject": "mathematics",
    "chapter": "7 - Finding the Unknown",
    "topic": "Finding Unknown Weights: Balance Scale Problems (Fig 7.6–7.8)",

    "learningObjectives": [
        "Understand that a balanced scale means both sides have equal total weight",
        "Learn to find unknown weights by removing equal known weights from both sides",
        "Frame simple equations from balance scale situations",
        "Solve single-variable linear equations using inverse operations",
        "Connect balance scale problems to algebraic equations (Bījagaṇita)"
    ],

    "teachingNotes": "Guide students through this interactive tool. Encourage exploration and discussion.",
    "instructionsForStudent": "To find an unknown weight on a balanced scale, remove the same known weight from both sides. The scale remains balanced.",
    "generationPrompt": "Process walkthrough showing how to find an unknown weight on a balance scale by removing equal known weights from both sides. Each step is animated showing the scale tilt and rebalance.",

    "interfaces": {
        "ModeType": "'learn' | 'practice'",
        "ScaleItem": {
            "id": "string",
            "label": "string",
            "emoji": "string",
            "weight": "number",
            "isUnknown": "boolean"
        },
        "ScaleProblem": {
            "id": "string",
            "title": "string",
            "leftItems": "ScaleItem[]",
            "rightItems": "ScaleItem[]",
            "unknownVar": "string",
            "equation": "string",
            "solution": "number",
            "hint": "string",
            "figRef": "string"
        },
        "MCQQuestion": {
            "id": "number",
            "q": "string",
            "pIdx": "number — index into problems array, -1 for no scale visual",
            "opts": "string[] — exactly 4 options",
            "ans": "number — 0-based index of correct option",
            "exp": "string — explanation shown after submit"
        },
        "LearnStep": {
            "id": "number",
            "title": "string",
            "desc": "string",
            "data?": {
                "pIdx?": "number — index into problems array",
                "eq?": "boolean — show equation chip",
                "allEq?": "boolean — show all equations together"
            }
        },
        "ScaleState": {
            "lw": "number — left weight total",
            "rw": "number — right weight total",
            "diff": "number — lw minus rw",
            "bal": "boolean — true if balanced"
        }
    },

    "parameters": {
        "width": { "type": "number", "default": 800, "description": "Width in pixels" },
        "height": { "type": "number", "default": 620, "description": "Height in pixels" },
        "initialMode": { "type": "ModeType", "enum": ["learn", "practice"], "default": "learn" },
        "showModeSelector": { "type": "boolean", "default": true },
        "enabledModes": { "type": "ModeType[]", "default": ["learn", "practice"] },
        "showNavigation": { "type": "boolean", "default": true },
        "showStepIndicator": { "type": "boolean", "default": true }
    },

    "additionalProps": {
        "description": "Tool-specific dynamic content passed via props.additionalProps",
        "properties": {
            "problems": {
                "type": "ScaleProblem[]",
                "description": "Custom balance scale problems. Defaults to 3 problems (Fig 7.6, 7.7, 7.8)."
            },
            "mcqQuestions": {
                "type": "MCQQuestion[]",
                "description": "Custom MCQ questions for practice mode. Defaults to 5 questions. pIdx links to problems array index (-1 for no scale)."
            }
        }
    },

