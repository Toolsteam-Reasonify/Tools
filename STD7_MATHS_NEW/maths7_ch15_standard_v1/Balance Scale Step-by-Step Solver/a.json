    "performanceNotes": [
        "SvgDefs extracted as React.memo static component — never re-renders",
        "renderScale wrapped in useCallback with [calcState, removed, solved] deps",
        "renderEq and renderSol wrapped in useCallback with [] deps",
        "Btn component wrapped in React.memo",
        "All setTimeout IDs tracked in timersRef and cleared on step change",
        "No inner component re-creation — Learn/Practice rendered as inline IIFEs",
        "Animation durations shortened to .3s–.35s for snappy feel",
        "Items use stable keys (item.id) not array index"
    ],

    "scaleRendering": {
        "itemPlacement": "Items sit ON pan surface at panY-6 (emoji bottom touches pan rim), not floating in air",
        "itemShadows": "Each item has a small elliptical shadow at panY-2 for grounded look",
        "weightLabels": "Below pan at panY+18, unknown items show '?'",
        "totalBadge": "Pill badge at panY+24 showing total weight per side",
        "tiltAnimation": "Beam rotates around center pivot, 0.85s cubic-bezier transition",
        "balanceIndicator": "Green checkmark circle above finial when balanced"
    },

