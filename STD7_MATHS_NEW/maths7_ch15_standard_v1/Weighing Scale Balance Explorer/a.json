{
    "toolName": "weighing_scale_explorer",
    "version": "4.0.0",
    "designSystem": "Singularity",
    "scaleStyle": "Realistic Brass Balance",
    "description": "Interactive structure explorer with a photorealistic brass balance scale. Students click on different parts (ornate crown fulcrum, brass beam, round concave pans, pointer, V-chains) to see labels and learn their role. Practice mode includes 5 MCQ questions on finding unknowns. The heavier side correctly tilts downward.",
    "topic": "Introduction to Finding Unknowns: The Weighing Scale Model",
    "subject": "Mathematics",
    "grade": "Grade 7",
    "curriculum": "NCERT Ganita Prakash Part-II, Chapter 7 - Finding the Unknown",
    "instructions_for_student": "A weighing scale balances when the total weight on the left pan equals the total weight on the right pan. The fulcrum is the pivot point. Click on any part of the scale to learn about it!",
    "designTokens": {
        "font": "Poppins",
        "primaryColors": {
            "indigo": "#4A4DC9",
            "orange": "#FF7212"
        },
        "secondaryColors": {
            "purple": "#533086",
            "lightOrange": "#FC9145"
        },
        "accentColors": {
            "lavender": "#C1C1EA",
            "cream": "#FFF3E4"
        },
        "neutralColors": {
            "dark": "#4E4E4E",
            "grey": "#CACACA",
            "lightGrey": "#EBEBEB",
            "offWhite": "#F5F5F5",
            "white": "#FFFFFF"
        },
        "brassPalette": {
            "gold": "#C5A54E",
            "goldLight": "#E0C97A",
            "goldBright": "#F0DDA0",
            "goldDark": "#8B7332",
            "goldDeep": "#6B5722",
            "panInner": "#D4B85C",
            "panRim": "#A08030",
            "panHighlight": "#F5E8B8",
            "chainGold": "#B89840"
        },
        "buttonStyles": ["contained", "outlined"],
        "borderRadius": {
            "sm": 8,
            "md": 12,
            "xl": 24,
            "pill": 999
        }
    },
    "scaleFeatures": {
        "fulcrum": "Ornate crown finial with scrollwork, sphere top, SVG path-based shape with brass gradients",
        "beam": "Long brass bar with linearGradient (bright top to dark bottom), decorative end-cap circles",
        "pillar": "Tall fluted column with linearGradient (dark-light-bright-light-dark for cylindrical sheen), decorative ring bands at top and bottom",
        "base": "Wide circular base with stacked brass ellipses and radialGradient",
        "chains": "3-point V-chains per side (offsets -22, 0, +22), 8 link segments each with elliptical link indicators",
        "pans": "Round concave brass dishes with radialGradient fill, inner dish, highlight arc, depth shadow",
        "pointer": "Thin brass indicator with arrow tip and bottom sphere, highlights to indigo on click",
        "tiltPhysics": "Heavier side tilts DOWN correctly (negated formula: -d*2.5), spring easing animation 1.4s"
    },
    "parameters": {
        "width": {
            "type": "number",
            "default": 800,
            "description": "Width of the tool in pixels"
        },
        "height": {
            "type": "number",
            "default": 600,
            "description": "Height of the tool in pixels"
        },
        "initialMode": {
            "type": "string",
            "enum": ["learn", "practice", "real_world"],
            "default": "learn",
            "description": "Starting mode"
        },
        "showModeSelector": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide mode tabs"
        },
        "enabledModes": {
            "type": "array",
            "default": ["learn", "practice", "real_world"],
            "description": "Available modes (no hands_on)"
        },
        "showNavigation": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide prev/next buttons"
        },
        "showPlayPause": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide play/pause button (hidden in practice mode)"
        },
        "showStepIndicator": {
            "type": "boolean",
            "default": true,
            "description": "Show/hide step counter in header"
        },
        "filterSteps": {
            "type": "array",
            "default": null,
            "description": "Only show these step IDs"
        },
        "animationSpeed": {
            "type": "number",
            "default": 1,
            "description": "Animation speed multiplier"
        },
        "autoPlayDuration": {
            "type": "number",
            "default": 10000,
            "description": "Auto-advance delay in ms (disabled in practice mode)"
        },
        "darkMode": {
            "type": "boolean",
            "default": false,
            "description": "Dark mode toggle"
        }
    },
    "additionalProps": {
        "description": "Tool-specific dynamic content for the weighing scale",
        "schema": {
            "leftWeights": {
                "type": "array",
                "items": "number",
                "default": [4],
                "description": "Weights for left pan. Use -1 for unknown '?' weight."
            },
            "rightWeights": {
                "type": "array",
                "items": "number",
                "default": [4],
                "description": "Weights for right pan. Use -1 for unknown '?' weight."
            },
            "showLabels": {
                "type": "boolean",
                "default": true,
                "description": "Show part labels on highlight"
            },
            "highlightComponent": {
                "type": "string",
                "enum": ["leftPan", "rightPan", "fulcrum", "pointer", "beam", null],
                "default": null,
                "description": "Which component to initially highlight"
            },
            "showWeightValues": {
                "type": "boolean",
                "default": true,
                "description": "Show numeric totals below each pan"
            },
            "animateBalance": {
                "type": "boolean",
                "default": true,
                "description": "Animate the scale tilt with spring easing"
            }
        }
    },
    "modes": {
        "learn": {
            "description": "Step-by-step introduction to each part of the realistic brass balance scale",
            "steps": [1, 2, 3, 4, 5, 6, 7, 8],
            "stepDetails": {
                "1": { "title": "Meet the Weighing Scale", "weights": "4 = 4", "highlight": null },
                "2": { "title": "The Fulcrum — Crown Pivot", "weights": "4 = 4", "highlight": "fulcrum" },
                "3": { "title": "The Beam — The Brass Bar", "weights": "4 = 4", "highlight": "beam" },
                "4": { "title": "The Left Pan (LHS)", "weights": "2+2 = 4", "highlight": "leftPan" },
                "5": { "title": "The Right Pan (RHS)", "weights": "4 = 2+2", "highlight": "rightPan" },
                "6": { "title": "The Pointer", "weights": "4 = 4", "highlight": "pointer" },
                "7": { "title": "Unequal Sides — Watch It Tilt!", "weights": "6 vs 3 (left heavier, tilts down-left)", "highlight": null },
                "8": { "title": "Balance = Equality!", "weights": "2+2 = 4", "highlight": null }
            }
        },
        "practice": {
            "description": "5 MCQ questions testing understanding of unknown weights and balance equations",
            "steps": [10, 11, 12, 13, 14],
            "questions": [
                { "id": 10, "question": "3 + ? = 7", "answer": 4, "options": [3, 4, 5, 7] },
                { "id": 11, "question": "5+5 = 4+?", "answer": 6, "options": [4, 5, 6, 10] },
                { "id": 12, "question": "16 ÷ 2 equal sacks", "answer": 8, "options": [4, 6, 8, 16] },
                { "id": 13, "question": "2+2+? = 10", "answer": 6, "options": [4, 5, 6, 8] },
                { "id": 14, "question": "3x = 12", "answer": 4, "options": [2, 3, 4, 6] }
            ]
        },
        "real_world": {
            "description": "Real-world applications of weighing scales",
            "steps": [20, 21, 22, 23],
            "stepDetails": {
                "20": { "title": "Vegetable Market 🥕", "weights": "2+3 = 5" },
                "21": { "title": "Chemistry Lab 🔬", "weights": "1+1+1 = 3" },
                "22": { "title": "Post Office 📦", "weights": "4 = 2+2" },
                "23": { "title": "Jeweller's Scale ✨", "weights": "5 = 5" }
            }
        }
    },
    "removedFeatures": [
        "hands_on mode (completely removed)",
        "Click hint text ('Click on any part of the scale to learn what it does')",
        "Teaching note footer ('📖 Teaching Note: Guide students through this tool...')"
    ],
    "bugFixes": [
        "Tilt direction corrected: heavier side now tilts DOWN (formula changed from d*2.5 to -d*2.5)",
        "Left heavier → negative rotation → counter-clockwise → left pan sinks down",
        "Right heavier → positive rotation → clockwise → right pan sinks down"
    ],
