        "autoPlayDuration": {
            "type": "number",
            "default": 0
        }
    },
    "additionalProps": {
        "description": "Quiz-specific dynamic content that agents can pass to customise the quiz.",
        "schema": {
            "questions": {
                "type": "array",
                "description": "Custom array of question objects. If omitted, uses the built-in 12-question bank.",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": { "type": "number", "description": "Unique question ID" },
                        "topic": { "type": "string", "description": "Topic name for grouping (e.g. 'Parity', 'Magic Squares')" },
                        "topicIcon": { "type": "string", "description": "Emoji icon for the topic" },
                        "question": { "type": "string", "description": "Question text" },
                        "options": { "type": "array", "items": { "type": "string" }, "description": "Array of 4 option strings" },
                        "correctIndex": { "type": "number", "description": "0-based index of the correct option" },
                        "explanation": { "type": "string", "description": "Detailed explanation shown after answering" }
                    },
                    "required": ["id", "topic", "question", "options", "correctIndex", "explanation"]
                }
            },
            "shuffleQuestions": {
                "type": "boolean",
                "default": true,
                "description": "Randomise question order on each attempt"
            },
            "shuffleOptions": {
                "type": "boolean",
                "default": false,
                "description": "Randomise option order within each question"
            },
            "showExplanations": {
                "type": "boolean",
                "default": true,
                "description": "Show explanation card after each answer"
            },
            "passingScore": {
                "type": "number",
                "default": 10,
                "description": "Minimum correct answers needed for a 'pass' message"
            },
            "title": {
                "type": "string",
                "default": "Number Play Quiz",
                "description": "Quiz header title"
            },
            "subtitle": {
                "type": "string",
                "default": "Chapter 6 — Ganita Prakash, Grade 7",
                "description": "Subtitle under the header"
            }
        },
        "examples": {
