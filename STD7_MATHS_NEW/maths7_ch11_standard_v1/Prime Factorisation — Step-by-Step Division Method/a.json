        "showPlayPause": { "type": "boolean", "default": true },
        "showStepIndicator": { "type": "boolean", "default": true },
        "animationSpeed": { "type": "number", "default": 1 },
        "autoPlayDuration": { "type": "number", "default": 8000 }
    },
    "additionalProps": {
        "properties": {
            "number": { "type": "number", "default": 1200 },
            "showHints": { "type": "boolean", "default": true },
            "showTeachingNotes": { "type": "boolean", "default": true },
            "primeColors": { "type": "object", "default": { "2": "#4A4DC9", "3": "#FF7212", "5": "#533086" } }
