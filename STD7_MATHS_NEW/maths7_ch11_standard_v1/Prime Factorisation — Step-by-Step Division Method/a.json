        "examples": {
            "default_1200": { "number": 1200 },
            "textbook_105": { "number": 105 },
            "textbook_360": { "number": 360 },
            "textbook_840": { "number": 840 }
        }
    },
    "modes": {
        "learn": { "description": "Guided walkthrough with teaching notes, division table, tree diagram" },
        "practice": { "description": "Quiz — identify smallest prime divisor at each step" }
    },
    "teaching_notes": {
        "step_1": "Present 1200. Smallest prime is 2.",
        "step_2_to_4": "Divide by 2 four times.",
        "step_5": "75 is odd. Digit-sum: 7+5=12, divisible by 3.",
        "step_6_7": "25 ends in 5, divide by 5. Then 5 is prime.",
        "summary": "1200 = 2 x 2 x 2 x 2 x 3 x 5 x 5."
    },
    "instructions_for_student": "Follow the division method step by step. At each step, identify the smallest prime number that divides the current number. Watch as the division format builds on the left and the tree diagram builds on the right. At the end, read off all the primes to write the complete prime factorisation of 1200."
