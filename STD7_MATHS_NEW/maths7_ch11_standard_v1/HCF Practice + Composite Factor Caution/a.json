                }
            },
            "instructions_for_student": "Verify your answers against the textbook!"
        },
        {
            "title": "Example 5: Factor-multiple pairs",
            "description": "HCF equals the smaller number",
            "parameters": {
                "additionalProps": {
                    "problems": [{ "num1": 6, "num2": 18 }, { "num1": 3, "num2": 24 }, { "num1": 81, "num2": 243 }, { "num1": 12, "num2": 60 }, { "num1": 25, "num2": 100 }]
                }
