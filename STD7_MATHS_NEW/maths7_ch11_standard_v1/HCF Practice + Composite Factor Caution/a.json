                    "problems": [{ "num1": 630, "num2": 770 }, { "num1": 300, "num2": 150 }, { "num1": 540, "num2": 100 }, { "num1": 1200, "num2": 360 }, { "num1": 840, "num2": 1050 }]
                }
            },
            "instructions_for_student": "Big numbers — take your time with prime factorisation!"
        },
        {
            "title": "Example 8: Custom caution demo",
            "description": "Using 90 and 150 in caution section",
            "parameters": {
                "additionalProps": {
                    "problems": [{ "num1": 24, "num2": 180 }, { "num1": 240, "num2": 378 }, { "num1": 400, "num2": 2500 }, { "num1": 300, "num2": 800 }, { "num1": 81, "num2": 243 }],
                    "cautionNumA": 90, "cautionNumB": 150,
                    "compositeA": "9 × 10", "compositeB": "15 × 10"
                }
            },
            "instructions_for_student": "Even with shared '10', you still need primes for the full HCF!"
